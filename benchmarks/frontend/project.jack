import bootstrap.analysis;
import bootstrap.modules;
import bootstrap.project;
import bootstrap.frontend;
import bootstrap.syntax;
import bootstrap.source;
import bootstrap.diagnostics;
import bootstrap.names;
import std.collections.arena;
import std.collections.vector;
import std.string;
import std.memory;

extern "c" i64 clock();

void measure(str entry) raises {
    ProjectOptions options = project_options();
    options.add_module_root("selfhost");
    options.add_module_root("jack");
    DiagnosticBag diagnostics(usize(100));
    ProjectBuilder builder = project_builder();

    i64 start = clock();
    load_module_graph_into(builder, entry, options, diagnostics);
    i64 loaded = clock();
    AnalysisState state = index_project(builder, diagnostics);
    i64 indexed = clock();
    resolve_project(builder, state, diagnostics);
    i64 resolved = clock();
    validate_analysis(builder.project());
    i64 validated = clock();

    &in FrontendProject project = builder.project();
    usize source_bytes = usize(0);
    usize nodes = usize(0);
    usize module_index = usize(0);
    while (module_index < project.module_count()) {
        ModuleId id = project.module_at(module_index);
        ParsedFileId file = project.module_record(id).parsed_file();
        &in ParsedFile parsed = project.frontend().file(file);
        source_bytes = source_bytes + project.frontend().source_map().source_len(
            parsed.source_id());
        nodes = nodes + parsed.node_count();
        module_index = module_index + usize(1);
    }
    usize receiver = usize(0);
    usize generic = usize(0);
    usize computed = usize(0);
    usize pattern = usize(0);
    usize selection = usize(0);
    usize occurrence_index = usize(0);
    while (occurrence_index < project.occurrence_count()) {
        ReferenceStatus status = project.occurrence(occurrence_index).binding();
        match (&in status) {
            .deferred(reason) {
                match (&in reason) {
                    .receiver_type { receiver = receiver + usize(1); }
                    .generic_type { generic = generic + usize(1); }
                    .computed_type { computed = computed + usize(1); }
                    .pattern_type { pattern = pattern + usize(1); }
                    .comptime_selection { selection = selection + usize(1); }
                }
            }
            _ { }
        }
        occurrence_index = occurrence_index + usize(1);
    }
    print(f"load_ticks\t{loaded - start}");
    print(f"index_ticks\t{indexed - loaded}");
    print(f"resolve_ticks\t{resolved - indexed}");
    print(f"validate_ticks\t{validated - resolved}");
    print(f"source_bytes\t{source_bytes}");
    print(f"modules\t{project.module_count()}");
    print(f"nodes\t{nodes}");
    print(f"symbols\t{project.symbol_count()}");
    print(f"occurrences\t{project.occurrence_count()}");
    print(f"receiver_type\t{receiver}");
    print(f"generic_type\t{generic}");
    print(f"computed_type\t{computed}");
    print(f"pattern_type\t{pattern}");
    print(f"comptime_selection\t{selection}");
    usize error_count = usize(0);
    if (project.has_errors()) { error_count = usize(1); }
    print(f"errors\t{error_count}");
}

i32 main(&in str[] arguments) {
    if (usize(len(arguments)) != usize(2)) { return 2; }
    try { measure(arguments[1]); return 0; }
    catch CapacityError { return 1; }
    catch LayoutError { return 1; }
    catch AllocationError { return 1; }
    catch BoundsError { return 1; }
    catch SourceMapError { return 1; }
    catch ArenaHandleError { return 1; }
    catch SyntaxValidationError { return 1; }
    catch FrontendReferenceError { return 1; }
    catch ProjectReferenceError { return 1; }
    catch NameReferenceError { return 1; }
    catch Utf8Error { return 1; }
}
