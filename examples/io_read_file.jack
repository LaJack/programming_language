import std.io;

void run() raises IoError {
    File file = open_read("examples/io.txt");
    u8[8] buffer;
    usize bytes_read = file.read(buffer[..]);
    close(file);

    print(bytes_read);
    print(buffer[0]);
    print(buffer[1]);
    print(buffer[2]);
    print(buffer[3]);
}

try {
    run();
} catch IoError {
    print("io error");
}
