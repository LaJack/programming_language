module std.collections.vector;

import std.memory;

pub struct BoundsError { }

pub struct Vector(comptime type T, comptime type A: Allocator) {
    A allocator;
    Allocation allocation;
    usize length;
    usize capacity;

    init(&inout self, move A allocator, usize initial_capacity)
        raises CapacityError, LayoutError, AllocationError
    {
        self.allocator = move allocator;
        Layout requested = layout_array(T, initial_capacity);
        self.allocation = self.allocator.allocate(requested);
        self.length = usize(0);
        Layout granted = self.allocation.layout();
        self.capacity = granted.size() / sizeof(T);
    }

    void push(&inout self, move T value)
        raises CapacityError, LayoutError, AllocationError
    {
        if (self.length == self.capacity) {
            usize next_capacity = usize(1);
            if (self.capacity != usize(0)) {
                usize maximum = 18446744073709551615;
                if (self.capacity > maximum / usize(2)) {
                    raise LayoutError { };
                }
                next_capacity = self.capacity * usize(2);
            }
            self.reserve(next_capacity);
        }
        unsafe {
            *inout b8 address = self.allocator.address_mut(self.allocation);
            *inout MaybeUninit(T) slots = address.cast(MaybeUninit(T));
            &inout MaybeUninit(T) slot = &inout *slots.offset(self.length);
            slot.write(value);
        }
        self.length = self.length + usize(1);
    }

    void reserve(&inout self, usize minimum_capacity)
        raises CapacityError, LayoutError, AllocationError
    {
        if (minimum_capacity > self.capacity) {
            Layout requested = layout_array(T, minimum_capacity);
            Allocation replacement = self.allocator.allocate(requested);
            unsafe {
                *inout b8 old_address = self.allocator.address_mut(self.allocation);
                *inout b8 new_address = self.allocator.address_mut(replacement);
                *inout MaybeUninit(T) old_slots = old_address.cast(MaybeUninit(T));
                *inout MaybeUninit(T) new_slots = new_address.cast(MaybeUninit(T));
                usize index = usize(0);
                while (index < self.length) {
                    &inout MaybeUninit(T) old_slot = &inout *old_slots.offset(index);
                    &inout MaybeUninit(T) new_slot = &inout *new_slots.offset(index);
                    T item = old_slot.take();
                    new_slot.write(item);
                    index = index + usize(1);
                }
                Allocation old_allocation = move self.allocation;
                self.allocator.deallocate(old_allocation);
            }
            self.allocation = move replacement;
            Layout granted = self.allocation.layout();
            self.capacity = granted.size() / sizeof(T);
        }
    }

    unsafe *in T data(&in self) {
        *in b8 address = self.allocator.address(self.allocation);
        *in MaybeUninit(T) slots = address.cast(MaybeUninit(T));
        return slots.cast(T);
    }

    &in T[] as_slice(&in self) {
        unsafe {
            return initialized_slice(self.data(), self.length);
        }
    }

    unsafe *inout T data_mut(&inout self) {
        *inout b8 address = self.allocator.address_mut(self.allocation);
        *inout MaybeUninit(T) slots = address.cast(MaybeUninit(T));
        return slots.cast(T);
    }

    &in T get(&in self, usize index) raises BoundsError {
        if (index >= self.length) {
            raise BoundsError { };
        }
        unsafe {
            *in b8 address = self.allocator.address(self.allocation);
            *in MaybeUninit(T) slots = address.cast(MaybeUninit(T));
            &in MaybeUninit(T) slot = &in *slots.offset(index);
            return slot.borrow();
        }
    }

    &inout T get_mut(&inout self, usize index) raises BoundsError {
        if (index >= self.length) {
            raise BoundsError { };
        }
        unsafe {
            *inout b8 address = self.allocator.address_mut(self.allocation);
            *inout MaybeUninit(T) slots = address.cast(MaybeUninit(T));
            &inout MaybeUninit(T) slot = &inout *slots.offset(index);
            return slot.borrow_mut();
        }
    }

    T replace(&inout self, usize index, move T value) raises BoundsError {
        if (index >= self.length) {
            raise BoundsError { };
        }
        unsafe {
            *inout b8 address = self.allocator.address_mut(self.allocation);
            *inout MaybeUninit(T) slots = address.cast(MaybeUninit(T));
            &inout MaybeUninit(T) slot = &inout *slots.offset(index);
            T previous = slot.take();
            slot.write(value);
            return previous;
        }
    }

    T pop(&inout self) raises BoundsError {
        if (self.length == usize(0)) {
            raise BoundsError { };
        }
        self.length = self.length - usize(1);
        unsafe {
            *inout b8 address = self.allocator.address_mut(self.allocation);
            *inout MaybeUninit(T) slots = address.cast(MaybeUninit(T));
            &inout MaybeUninit(T) slot = &inout *slots.offset(self.length);
            return slot.take();
        }
    }

    void clear(&inout self) {
        unsafe {
            *inout b8 address = self.allocator.address_mut(self.allocation);
            *inout MaybeUninit(T) slots = address.cast(MaybeUninit(T));
            while (self.length != usize(0)) {
                self.length = self.length - usize(1);
                &inout MaybeUninit(T) slot = &inout *slots.offset(self.length);
                T item = slot.take();
            }
        }
    }

    usize len(&in self) {
        return self.length;
    }

    usize capacity(&in self) { return self.capacity; }
    usize remaining_capacity(&in self) { return self.capacity - self.length; }
    bool is_empty(&in self) { return self.length == usize(0); }
    bool is_full(&in self) { return self.length == self.capacity; }

    deinit(move self) {
        self.clear();
        unsafe {
            Allocation allocation = move self.allocation;
            self.allocator.deallocate(allocation);
        }
    }
}
