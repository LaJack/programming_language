module bootstrap.lexer;

import bootstrap.source;
import bootstrap.lexer_generator;
import std.collections.vector;
import std.io;
import std.memory;
import std.string;

comptime File token_file = open_read("selfhost/bootstrap/jack.tokens");
comptime SystemAllocator token_source_allocator;
comptime String(SystemAllocator) token_source = read_to_string(
    SystemAllocator, token_file, token_source_allocator
);
comptime SystemAllocator token_variant_allocator;
comptime Vector(UnionVariant, SystemAllocator) token_variants(
    token_variant_allocator, usize(0)
);
comptime SystemAllocator compiled_lexer_allocator;
comptime CompiledLexer compiled_lexer = compile_lexer(
    true,
    token_source.bytes(),
    compiled_lexer_allocator,
    token_variants
);
pub comptime type TokenKind = Union(token_variants.as_slice());
const LexerTables(compiled_lexer.states, compiled_lexer.rule_count) lexer_tables =
    comptime freeze_lexer(
        compiled_lexer.states, compiled_lexer.rule_count, true, compiled_lexer
    );

pub struct Token {
    TokenKind kind;
    SourceSpan span;

    u8 kind_value(&in self) {
        return match (&in self.kind) {
            .eof => u8(0),
            .identifier => u8(1),
            .integer => u8(2),
            .floating => u8(3),
            .string => u8(4),
            .symbol => u8(5),
            .invalid => u8(6),
            .formatted_string => u8(7),
        };
    }
    usize start_offset(&in self) { return self.span.start_offset(); }
    usize end_offset(&in self) { return self.span.end_offset(); }
    usize line_number(&in self) { return self.span.line_number(); }
    usize column_number(&in self) { return self.span.column_number(); }
    SourceSpan source_location(&in self) { return self.span; }
}

pub TokenKind token_eof() { return TokenKind.eof; }
pub TokenKind token_identifier() { return TokenKind.identifier; }
pub TokenKind token_integer() { return TokenKind.integer; }
pub TokenKind token_float() { return TokenKind.floating; }
pub TokenKind token_string() { return TokenKind.string; }
pub TokenKind token_symbol() { return TokenKind.symbol; }
pub TokenKind token_invalid() { return TokenKind.invalid; }
pub TokenKind token_formatted_string() { return TokenKind.formatted_string; }

bool is_escape(u8 value) {
    if (value == u8(34)) { return true; }
    if (value == u8(92)) { return true; }
    if (value == u8(110)) { return true; }
    if (value == u8(114)) { return true; }
    if (value == u8(116)) { return true; }
    return value == u8(48);
}

void emit(
    comptime type A: Allocator,
    &inout Vector(Token, A) tokens,
    TokenKind kind,
    usize start,
    usize end,
    usize line,
    usize column,
    SourceId source_id
) raises CapacityError, LayoutError, AllocationError {
    tokens.push(Token {
        kind = kind;
        span = source_span(source_id, start, end, line, column);
    });
}

TokenKind token_kind(u16 index) {
    if (index == u16(0)) { return TokenKind.eof; }
    if (index == u16(1)) { return TokenKind.identifier; }
    if (index == u16(2)) { return TokenKind.integer; }
    if (index == u16(3)) { return TokenKind.floating; }
    if (index == u16(4)) { return TokenKind.string; }
    if (index == u16(5)) { return TokenKind.symbol; }
    if (index == u16(7)) { return TokenKind.formatted_string; }
    return TokenKind.invalid;
}

struct HandlerResult {
    usize end;
    usize line;
    usize column;
    bool valid;
    bool emit_token;
}

HandlerResult scan_handler(
    &in u8[] source,
    usize start,
    usize prefix_end,
    usize line,
    usize column,
    u8 handler
) {
    usize index = prefix_end;
    usize current_line = line;
    usize current_column = column + prefix_end - start;
    bool valid = true;
    bool emit_token = true;
    bool scanning = true;
    if (handler == u8(3)) {
        emit_token = false;
        while (index < usize(len(source)) && source[index] != u8(10)) {
            index = index + usize(1);
            current_column = current_column + usize(1);
        }
        scanning = false;
    } elif (handler == u8(4)) {
        emit_token = false;
        valid = false;
        while (index < usize(len(source)) && scanning) {
            if (index + usize(1) < usize(len(source))) {
                if (source[index] == u8(42) && source[index + usize(1)] == u8(47)) {
                    index = index + usize(2);
                    current_column = current_column + usize(2);
                    scanning = false;
                    valid = true;
                } elif (source[index] == u8(10)) {
                    index = index + usize(1);
                    current_line = current_line + usize(1);
                    current_column = usize(1);
                } else {
                    index = index + usize(1);
                    current_column = current_column + usize(1);
                }
            } else {
                index = index + usize(1);
                current_column = current_column + usize(1);
            }
        }
        if (valid == false) { emit_token = true; }
    } else {
        while (index < usize(len(source)) && scanning) {
            u8 value = source[index];
            if (value == u8(10)) {
                valid = false;
                scanning = false;
            } elif (value == u8(34)) {
                index = index + usize(1);
                current_column = current_column + usize(1);
                scanning = false;
            } elif (value == u8(92)) {
                index = index + usize(1);
                current_column = current_column + usize(1);
                if (index >= usize(len(source))) {
                    valid = false;
                    scanning = false;
                } else {
                    if (handler == u8(1) && is_escape(source[index]) == false) {
                        valid = false;
                    }
                    index = index + usize(1);
                    current_column = current_column + usize(1);
                }
            } else {
                index = index + usize(1);
                current_column = current_column + usize(1);
            }
        }
        if (scanning) { valid = false; }
    }
    return HandlerResult {
        end = index,
        line = current_line,
        column = current_column,
        valid = valid,
        emit_token = emit_token,
    };
}

pub Vector(Token, A) lex(
    comptime type A: Allocator,
    SourceId source_id,
    &in u8[] source,
    move A allocator
) raises CapacityError, LayoutError, AllocationError {
    Vector(Token, A) tokens(allocator, usize(0));
    usize index = usize(0);
    usize line = usize(1);
    usize column = usize(1);
    while (index < usize(len(source))) {
        usize start = index;
        usize start_line = line;
        usize start_column = column;
        u16 state = u16(0);
        u16 accepted = u16(65535);
        usize accepted_end = index;
        usize cursor = index;
        bool scanning = true;
        while (cursor < usize(len(source)) && scanning) {
            u16 next = lexer_tables.transition(state, source[cursor]);
            if (next == u16(65535)) {
                scanning = false;
            } else {
                state = next;
                cursor = cursor + usize(1);
                u16 candidate = lexer_tables.accepting(state);
                if (candidate != u16(65535)) {
                    accepted = candidate;
                    accepted_end = cursor;
                }
            }
        }
        if (accepted == u16(65535)) {
            emit(
                A, tokens, token_invalid(), index, index + usize(1),
                line, column, source_id
            );
            index = index + usize(1);
            column = column + usize(1);
        } else {
            u16 rule_token = lexer_tables.rule_token(accepted);
            u8 rule_handler = lexer_tables.rule_handler(accepted);
            bool rule_skips = lexer_tables.rule_skips(accepted);
            if (rule_handler != u8(0)) {
                HandlerResult result = scan_handler(
                    source, start, accepted_end, line, column, rule_handler
                );
                index = result.end;
                line = result.line;
                column = result.column;
                if (result.emit_token) {
                    TokenKind kind = token_kind(rule_token);
                    if (result.valid == false) { kind = token_invalid(); }
                    emit(
                        A, tokens, kind, start, index,
                        start_line, start_column, source_id
                    );
                }
            } else {
                index = accepted_end;
                usize consumed_at = start;
                while (consumed_at < accepted_end) {
                    u8 consumed = source[consumed_at];
                    if (consumed == u8(10)) {
                        line = line + usize(1);
                        column = usize(1);
                    } else {
                        column = column + usize(1);
                    }
                    consumed_at = consumed_at + usize(1);
                }
                if (rule_skips == false) {
                    emit(
                        A, tokens, token_kind(rule_token),
                        start, index,
                        start_line, start_column, source_id
                    );
                }
            }
        }
    }
    emit(A, tokens, token_eof(), index, index, line, column, source_id);
    return tokens;
}
