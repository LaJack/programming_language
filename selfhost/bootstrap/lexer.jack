module bootstrap.lexer;

import bootstrap.source;
import std.collections.vector;
import std.memory;

pub union TokenKind {
    eof;
    identifier;
    integer;
    floating;
    string;
    symbol;
    invalid;
    formatted_string;
}

pub struct Token {
    TokenKind kind;
    SourceSpan span;

    u8 kind_value(&in self) {
        return match (&in self.kind) {
            .eof => u8(0),
            .identifier => u8(1),
            .integer => u8(2),
            .floating => u8(3),
            .string => u8(4),
            .symbol => u8(5),
            .invalid => u8(6),
            .formatted_string => u8(7),
        };
    }
    usize start_offset(&in self) { return self.span.start_offset(); }
    usize end_offset(&in self) { return self.span.end_offset(); }
    usize line_number(&in self) { return self.span.line_number(); }
    usize column_number(&in self) { return self.span.column_number(); }
}

pub TokenKind token_eof() { return TokenKind.eof; }
pub TokenKind token_identifier() { return TokenKind.identifier; }
pub TokenKind token_integer() { return TokenKind.integer; }
pub TokenKind token_float() { return TokenKind.floating; }
pub TokenKind token_string() { return TokenKind.string; }
pub TokenKind token_symbol() { return TokenKind.symbol; }
pub TokenKind token_invalid() { return TokenKind.invalid; }
pub TokenKind token_formatted_string() { return TokenKind.formatted_string; }

bool is_alpha(u8 value) {
    if (value >= u8(97)) {
        if (value <= u8(122)) { return true; }
    }
    if (value >= u8(65)) {
        if (value <= u8(90)) { return true; }
    }
    return value == u8(95);
}

bool is_digit(u8 value) {
    if (value < u8(48)) { return false; }
    return value <= u8(57);
}

bool is_symbol(u8 value) {
    if (value == u8(123)) { return true; }
    if (value == u8(125)) { return true; }
    if (value == u8(40)) { return true; }
    if (value == u8(41)) { return true; }
    if (value == u8(91)) { return true; }
    if (value == u8(93)) { return true; }
    if (value == u8(59)) { return true; }
    if (value == u8(44)) { return true; }
    if (value == u8(58)) { return true; }
    if (value == u8(43)) { return true; }
    if (value == u8(45)) { return true; }
    if (value == u8(46)) { return true; }
    if (value == u8(61)) { return true; }
    if (value == u8(60)) { return true; }
    if (value == u8(62)) { return true; }
    if (value == u8(33)) { return true; }
    if (value == u8(42)) { return true; }
    if (value == u8(63)) { return true; }
    if (value == u8(47)) { return true; }
    if (value == u8(37)) { return true; }
    return value == u8(38);
}

bool is_escape(u8 value) {
    if (value == u8(34)) { return true; }
    if (value == u8(92)) { return true; }
    if (value == u8(110)) { return true; }
    if (value == u8(114)) { return true; }
    if (value == u8(116)) { return true; }
    return value == u8(48);
}

void emit(
    comptime type A: Allocator,
    &inout Vector(Token, A) tokens,
    TokenKind kind,
    usize start,
    usize end,
    usize line,
    usize column
) raises CapacityError, LayoutError, AllocationError {
    tokens.push(Token {
        kind = kind;
        span = SourceSpan {
            start = start;
            end = end;
            line = line;
            column = column;
        };
    });
}

pub Vector(Token, A) lex(
    comptime type A: Allocator,
    &in u8[] source,
    move A allocator
) raises CapacityError, LayoutError, AllocationError {
    Vector(Token, A) tokens(allocator, usize(0));
    usize index = 0;
    usize line = 1;
    usize column = 1;

    while (index < usize(len(source))) {
        u8 current = source[index];
        bool formatted_string = false;
        if (current == u8(102)) {
            if (index + usize(1) < usize(len(source))) {
                if (source[index + usize(1)] == u8(34)) {
                    formatted_string = true;
                }
            }
        }
        if (current == u8(32)) {
            index = index + usize(1);
            column = column + usize(1);
        } elif (current == u8(9)) {
            index = index + usize(1);
            column = column + usize(1);
        } elif (current == u8(13)) {
            index = index + usize(1);
            column = column + usize(1);
        } elif (current == u8(10)) {
            index = index + usize(1);
            line = line + usize(1);
            column = 1;
        } elif (formatted_string) {
            usize start = index;
            usize start_line = line;
            usize start_column = column;
            index = index + usize(2);
            column = column + usize(2);
            bool scanning = true;
            bool valid = true;
            while (scanning) {
                if (index >= usize(len(source))) {
                    scanning = false;
                    valid = false;
                } elif (source[index] == u8(10)) {
                    scanning = false;
                    valid = false;
                } elif (source[index] == u8(34)) {
                    index = index + usize(1);
                    column = column + usize(1);
                    scanning = false;
                } elif (source[index] == u8(92)) {
                    index = index + usize(1);
                    column = column + usize(1);
                    if (index < usize(len(source))) {
                        index = index + usize(1);
                        column = column + usize(1);
                    } else {
                        scanning = false;
                        valid = false;
                    }
                } else {
                    index = index + usize(1);
                    column = column + usize(1);
                }
            }
            if (valid) {
                emit(A, tokens, token_formatted_string(), start, index, start_line, start_column);
            } else {
                emit(A, tokens, token_invalid(), start, index, start_line, start_column);
            }
        } elif (is_alpha(current)) {
            usize start = index;
            usize start_column = column;
            bool scanning = true;
            while (scanning) {
                index = index + usize(1);
                column = column + usize(1);
                if (index >= usize(len(source))) {
                    scanning = false;
                } elif (is_alpha(source[index])) {
                } elif (is_digit(source[index])) {
                } else {
                    scanning = false;
                }
            }
            emit(A, tokens, token_identifier(), start, index, line, start_column);
        } elif (is_digit(current)) {
            usize start = index;
            usize start_column = column;
            bool scanning = true;
            bool floating = false;
            while (scanning) {
                index = index + usize(1);
                column = column + usize(1);
                if (index >= usize(len(source))) {
                    scanning = false;
                } elif (is_digit(source[index])) {
                } else {
                    scanning = false;
                }
            }
            if (index < usize(len(source))) {
                if (source[index] == u8(46)) {
                    if (index + usize(1) < usize(len(source))) {
                        if (is_digit(source[index + usize(1)])) {
                            floating = true;
                            index = index + usize(1);
                            column = column + usize(1);
                            bool fraction = true;
                            while (fraction) {
                                index = index + usize(1);
                                column = column + usize(1);
                                if (index >= usize(len(source))) {
                                    fraction = false;
                                } elif (is_digit(source[index])) {
                                } else {
                                    fraction = false;
                                }
                            }
                        }
                    }
                }
            }
            if (floating) {
                emit(A, tokens, token_float(), start, index, line, start_column);
            } else {
                emit(A, tokens, token_integer(), start, index, line, start_column);
            }
        } elif (current == u8(34)) {
            usize start = index;
            usize start_line = line;
            usize start_column = column;
            index = index + usize(1);
            column = column + usize(1);
            bool scanning = true;
            bool valid = true;
            while (scanning) {
                if (index >= usize(len(source))) {
                    scanning = false;
                    valid = false;
                } elif (source[index] == u8(10)) {
                    scanning = false;
                    valid = false;
                } elif (source[index] == u8(34)) {
                    index = index + usize(1);
                    column = column + usize(1);
                    scanning = false;
                } elif (source[index] == u8(92)) {
                    index = index + usize(1);
                    column = column + usize(1);
                    if (index < usize(len(source))) {
                        if (is_escape(source[index]) == false) { valid = false; }
                        index = index + usize(1);
                        column = column + usize(1);
                    } else {
                        scanning = false;
                        valid = false;
                    }
                } else {
                    index = index + usize(1);
                    column = column + usize(1);
                }
            }
            if (valid) {
                emit(A, tokens, token_string(), start, index, start_line, start_column);
            } else {
                emit(A, tokens, token_invalid(), start, index, start_line, start_column);
            }
        } elif (current == u8(47)) {
            bool line_comment = false;
            bool block_comment = false;
            if (index + usize(1) < usize(len(source))) {
                if (source[index + usize(1)] == u8(47)) { line_comment = true; }
                if (source[index + usize(1)] == u8(42)) { block_comment = true; }
            }
            if (line_comment) {
                index = index + usize(2);
                column = column + usize(2);
                bool scanning = true;
                while (scanning) {
                    if (index >= usize(len(source))) {
                        scanning = false;
                    } elif (source[index] == u8(10)) {
                        scanning = false;
                    } else {
                        index = index + usize(1);
                        column = column + usize(1);
                    }
                }
            } elif (block_comment) {
                usize start = index;
                usize start_line = line;
                usize start_column = column;
                index = index + usize(2);
                column = column + usize(2);
                bool scanning = true;
                bool valid = false;
                while (scanning) {
                    if (index >= usize(len(source))) {
                        scanning = false;
                    } elif (index + usize(1) < usize(len(source))) {
                        if (source[index] == u8(42)) {
                            if (source[index + usize(1)] == u8(47)) {
                                index = index + usize(2);
                                column = column + usize(2);
                                scanning = false;
                                valid = true;
                            } else {
                                index = index + usize(1);
                                column = column + usize(1);
                            }
                        } elif (source[index] == u8(10)) {
                            index = index + usize(1);
                            line = line + usize(1);
                            column = 1;
                        } else {
                            index = index + usize(1);
                            column = column + usize(1);
                        }
                    } else {
                        index = index + usize(1);
                        column = column + usize(1);
                    }
                }
                if (valid == false) {
                    emit(A, tokens, token_invalid(), start, index, start_line, start_column);
                }
            } else {
                emit(A, tokens, token_symbol(), index, index + usize(1), line, column);
                index = index + usize(1);
                column = column + usize(1);
            }
        } elif (is_symbol(current)) {
            usize width = 1;
            if (index + usize(1) < usize(len(source))) {
                u8 next = source[index + usize(1)];
                if (current == u8(61)) {
                    if (next == u8(61)) { width = 2; }
                } elif (current == u8(33)) {
                    if (next == u8(61)) { width = 2; }
                } elif (current == u8(60)) {
                    if (next == u8(61)) { width = 2; }
                } elif (current == u8(62)) {
                    if (next == u8(61)) { width = 2; }
                } elif (current == u8(46)) {
                    if (next == u8(46)) { width = 2; }
                }
            }
            emit(A, tokens, token_symbol(), index, index + width, line, column);
            index = index + width;
            column = column + width;
        } else {
            emit(A, tokens, token_invalid(), index, index + usize(1), line, column);
            index = index + usize(1);
            column = column + usize(1);
        }
    }

    emit(A, tokens, token_eof(), index, index, line, column);
    return tokens;
}
