module bootstrap.main;

import bootstrap.diagnostics;
import bootstrap.lexer;
import bootstrap.parser;
import bootstrap.frontend;
import bootstrap.source;
import bootstrap.syntax;
import bootstrap.syntax_dump;
import std.collections.arena;
import std.collections.vector;
import std.io;
import std.memory;
import std.string;

void append_separator(&inout StringBuilder(SystemAllocator) output)
    raises CapacityError, LayoutError, AllocationError
{
    output.append("\t");
}

void write_token(&in Token token)
    raises CapacityError, LayoutError, AllocationError, Utf8Error, IoError
{
    SystemAllocator allocator;
    StringBuilder(SystemAllocator) output(allocator);
    output.append_u64(u64(token.kind_value()));
    append_separator(output);
    output.append_usize(token.start_offset());
    append_separator(output);
    output.append_usize(token.end_offset());
    append_separator(output);
    output.append_usize(token.line_number());
    append_separator(output);
    output.append_usize(token.column_number());
    output.append("\n");
    String(SystemAllocator) line = finish_string(SystemAllocator, output);
    write_stdout(line.as_str());
}

bool dump_tokens(
    &in Vector(Token, SystemAllocator) tokens,
    &inout DiagnosticBag diagnostics
)
    raises CapacityError, LayoutError, AllocationError, Utf8Error, IoError,
        BoundsError
{
    usize index = usize(0);
    bool invalid = false;
    while (index < tokens.len()) {
        &in Token token = tokens.get(index);
        write_token(token);
        if (invalid == false) {
            if (token.kind_value() == u8(6)) {
                invalid = true;
                Diagnostic diagnostic = source_diagnostic(
                    DiagnosticSeverity.error,
                    "lex.invalid-token",
                    token.source_location(),
                    "invalid token"
                );
                diagnostics.add(diagnostic);
            }
        }
        index = index + usize(1);
    }
    return invalid;
}

void write_locationless(
    DiagnosticFormat format,
    str code,
    str message
)
    raises CapacityError, LayoutError, AllocationError, Utf8Error, IoError,
        SourceMapError, BoundsError
{
    SourceMap sources = source_map();
    DiagnosticBag diagnostics(usize(1));
    Diagnostic diagnostic = locationless_diagnostic(
        DiagnosticSeverity.error, code, message
    );
    diagnostics.add(diagnostic);
    String(SystemAllocator) rendered = render_diagnostics(
        sources, diagnostics, format
    );
    write_stderr(rendered.as_str());
}

void write_numbered_locationless(
    DiagnosticFormat format,
    str code,
    str prefix,
    usize value
) raises CapacityError, LayoutError, AllocationError, Utf8Error, IoError,
         SourceMapError, BoundsError {
    SystemAllocator allocator;
    StringBuilder(SystemAllocator) output(allocator);
    output.append(prefix);
    output.append_usize(value);
    String(SystemAllocator) message = finish_string(SystemAllocator, output);
    write_locationless(format, code, message.as_str());
}

void write_io_locationless(DiagnosticFormat format, i32 value)
    raises CapacityError, LayoutError, AllocationError, Utf8Error, IoError,
        SourceMapError, BoundsError
{
    SystemAllocator allocator;
    StringBuilder(SystemAllocator) output(allocator);
    output.append("I/O operation failed with code ");
    output.append_i64(i64(value));
    String(SystemAllocator) message = finish_string(SystemAllocator, output);
    write_locationless(format, "io.operation", message.as_str());
}

void fallback(str message) {
    try { write_stderr(message); }
    catch IoError { }
}

void report_locationless(DiagnosticFormat format, str code, str message) {
    try { write_locationless(format, code, message); }
    catch CapacityError { fallback("error\tdiagnostic\n"); }
    catch LayoutError { fallback("error\tdiagnostic\n"); }
    catch AllocationError { fallback("error\tdiagnostic\n"); }
    catch Utf8Error { fallback("error\tdiagnostic\n"); }
    catch IoError { fallback("error\tdiagnostic\n"); }
    catch SourceMapError { fallback("error\tdiagnostic\n"); }
    catch BoundsError { fallback("error\tdiagnostic\n"); }
}

void report_numbered(
    DiagnosticFormat format, str code, str prefix, usize value
) {
    try { write_numbered_locationless(format, code, prefix, value); }
    catch CapacityError { fallback("error\tdiagnostic\n"); }
    catch LayoutError { fallback("error\tdiagnostic\n"); }
    catch AllocationError { fallback("error\tdiagnostic\n"); }
    catch Utf8Error { fallback("error\tdiagnostic\n"); }
    catch IoError { fallback("error\tdiagnostic\n"); }
    catch SourceMapError { fallback("error\tdiagnostic\n"); }
    catch BoundsError { fallback("error\tdiagnostic\n"); }
}

void report_io(DiagnosticFormat format, i32 value) {
    try { write_io_locationless(format, value); }
    catch CapacityError { fallback("error\tdiagnostic\n"); }
    catch LayoutError { fallback("error\tdiagnostic\n"); }
    catch AllocationError { fallback("error\tdiagnostic\n"); }
    catch Utf8Error { fallback("error\tdiagnostic\n"); }
    catch IoError { fallback("error\tdiagnostic\n"); }
    catch SourceMapError { fallback("error\tdiagnostic\n"); }
    catch BoundsError { fallback("error\tdiagnostic\n"); }
}

Vector(Token, SystemAllocator) lex_source(&in FrontendContext context, SourceId source_id)
    raises SourceMapError, CapacityError, LayoutError, AllocationError {
    &in SourceMap sources = context.source_map();
    &in u8[] bytes = sources.bytes(source_id);
    SystemAllocator allocator;
    return lex(SystemAllocator, source_id, bytes, allocator);
}

i32 run(str path, DiagnosticFormat format, bool syntax_mode)
    raises IoError, Utf8Error, CapacityError, LayoutError, AllocationError,
        BoundsError, SourceMapError, ArenaHandleError, FrontendReferenceError, SyntaxValidationError
{
    File file = open_read(path);
    SystemAllocator source_allocator;
    String(SystemAllocator) source =
        read_to_string(SystemAllocator, file, source_allocator);
    close(file);

    FrontendContext context = frontend_context();
    SourceId source_id = context.add_source(path, source);
    Vector(Token, SystemAllocator) tokens = lex_source(context, source_id);
    DiagnosticBag diagnostics(usize(20));
    if (syntax_mode) {
        ParsedFileId parsed_id = parse_recovering(
            context, source_id, tokens, diagnostics
        );
        &in ParsedFile parsed = context.file(parsed_id);
        String(SystemAllocator) syntax = dump_syntax(parsed);
        write_stdout(syntax.as_str());
        if (diagnostics.is_empty() == false) {
            &in SourceMap sources = context.source_map();
            String(SystemAllocator) rendered = render_diagnostics(
                sources, diagnostics, format
            );
            write_stderr(rendered.as_str());
            return 1;
        }
        return 0;
    } else {
        bool invalid = dump_tokens(tokens, diagnostics);
        if (invalid) {
            &in SourceMap sources = context.source_map();
            String(SystemAllocator) rendered = render_diagnostics(
                sources, diagnostics, format
            );
            write_stderr(rendered.as_str());
            return 1;
        }
        return 0;
    }
}

i32 main(&in str[] arguments) {
    DiagnosticFormat format = DiagnosticFormat.human;
    str path = "";
    bool syntax_mode = false;
    bool path_set = false;
    bool format_set = false;
    bool dump_set = false;
    bool valid = true;
    usize index = usize(1);
    while (index < usize(len(arguments)) && valid) {
        if (arguments[index] == "--diagnostic-format") {
            if (format_set || index + usize(1) >= usize(len(arguments))) {
                valid = false;
            } else {
                format_set = true;
                index = index + usize(1);
                if (arguments[index] == "stable") { format = DiagnosticFormat.stable; }
                elif (arguments[index] != "human") { valid = false; }
            }
        } elif (arguments[index] == "--dump") {
            if (dump_set || index + usize(1) >= usize(len(arguments))) {
                valid = false;
            } else {
                dump_set = true;
                index = index + usize(1);
                if (arguments[index] == "syntax") { syntax_mode = true; }
                elif (arguments[index] != "tokens") { valid = false; }
            }
        } else {
            if (path_set || (len(arguments[index]) > usize(0)
                && jack_str_byte(arguments[index], usize(0)) == u8(45))) { valid = false; }
            else { path = arguments[index]; path_set = true; }
        }
        index = index + usize(1);
    }
    if (valid == false || path_set == false) {
        try { write_stderr("usage: jack-bootstrap [--diagnostic-format human|stable] [--dump tokens|syntax] <source>\n"); }
        catch IoError { }
        return 2;
    }
    try {
        return run(path, format, syntax_mode);
    } catch IoError error {
        report_io(format, error.error_code());
    } catch Utf8Error error {
        report_numbered(
            format, "source.invalid-utf8", "invalid UTF-8 at byte offset ",
            error.position()
        );
    } catch CapacityError {
        report_locationless(format, "memory.capacity", "capacity exhausted");
    } catch LayoutError {
        report_locationless(format, "memory.layout", "invalid memory layout");
    } catch AllocationError {
        report_locationless(format, "memory.allocation", "allocation failed");
    } catch BoundsError {
        report_locationless(format, "collections.bounds", "index out of bounds");
    } catch SourceMapError {
        report_locationless(format, "source.invalid-span", "invalid source location");
    } catch SyntaxValidationError {
        report_locationless(format, "syntax.invalid-tree", "invalid syntax tree");
    } catch FrontendReferenceError {
        report_locationless(format, "syntax.invalid-reference", "invalid syntax reference");
    } catch ArenaHandleError {
        report_locationless(format, "syntax.invalid-handle", "invalid syntax node handle");
    }
    return 1;
}
