pub ArenaHandle(SyntaxNode) syntax_child(
    &in ParsedFile file, &in SyntaxNode node, usize requested
) raises BoundsError {
    usize offset = usize(0);
    match (&in node.data) {
        .invalid_declaration {

        }
        .invalid_statement {

        }
        .invalid_type {

        }
        .invalid_pattern {

        }
        .invalid_expression {

        }
        .module_declaration(path) {

        }
        .import_declaration(path, alias, symbols) {
            if (requested >= offset && requested - offset < symbols.len()) {
                return file.child(symbols, requested - offset);
            }
            offset = offset + symbols.len();
        }
        .import_path(name) {

        }
        .import_symbol(name) {

        }
        .struct_declaration(name, modifiers, parameters, body) {
            if (requested >= offset && requested - offset < parameters.len()) {
                return file.child(parameters, requested - offset);
            }
            offset = offset + parameters.len();
            match (body) {
                .absent { }
                .present(handle) {
                    if (requested == offset) { return handle; }
                    offset = offset + usize(1);
                }
            }
        }
