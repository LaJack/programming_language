module bootstrap.syntax;

import bootstrap.lexer;
import bootstrap.source;
import std.collections.arena;
import std.collections.vector;
import std.memory;

pub union SyntaxKind {
    invalid_declaration;
    invalid_statement;
    invalid_type;
    invalid_pattern;
    invalid_expression;
    module_declaration;
    import_declaration;
    import_path;
    import_symbol;
    struct_declaration;
    union_declaration;
    interface_declaration;
    implementation_declaration;
    implementation_use;
    view_declaration;
    view_field;
    extern_type_declaration;
    function_declaration;
    parameter;
    field_declaration;
    variable_declaration;
    constant_declaration;
    comptime_type_declaration;
    union_variant;
    block_statement;
    unsafe_block;
    comptime_statement;
    expression_statement;
    assignment_statement;
    if_statement;
    if_branch;
    else_branch;
    while_statement;
    for_statement;
    try_statement;
    catch_clause;
    return_statement;
    raise_statement;
    rethrow_statement;
    print_statement;
    match_statement;
    match_expression;
    match_arm;
    variant_pattern;
    wildcard_pattern;
    binding_pattern;
    named_type;
    generic_type;
    array_type;
    slice_type;
    borrow_type;
    raw_pointer_type;
    nullable_pointer_type;
    type_argument;
    name_expression;
    integer_literal;
    floating_literal;
    string_literal;
    formatted_string;
    formatted_text;
    boolean_literal;
    null_literal;
    unary_expression;
    binary_expression;
    borrow_expression;
    move_expression;
    dereference_expression;
    call_expression;
    member_expression;
    index_expression;
    slice_expression;
    struct_literal;
    struct_literal_field;
    union_variant_expression;
    parenthesized_expression;
    absent;
}

pub union NodeLink {
    absent;
    present(ArenaHandle(SyntaxNode) node);
}

pub struct DeclarationModifiers {
    SourceSpan abi;
    SourceSpan abi_span(&in self) { return self.abi; }
    bool is_public;
    bool is_comptime;
    bool is_constant;
    bool is_unsafe;
    bool is_extern;
    bool is_consuming;
    bool is_constructor;
    bool is_comptime_initializer;
    bool is_raises_inferred;
    bool public_flag(&in self) { return self.is_public; }
    bool comptime_flag(&in self) { return self.is_comptime; }
    bool constant_flag(&in self) { return self.is_constant; }
    bool unsafe_flag(&in self) { return self.is_unsafe; }
    bool extern_flag(&in self) { return self.is_extern; }
    bool consuming_flag(&in self) { return self.is_consuming; }
    bool constructor_flag(&in self) { return self.is_constructor; }
    bool comptime_initializer_flag(&in self) { return self.is_comptime_initializer; }
    bool raises_inferred_flag(&in self) { return self.is_raises_inferred; }
}

pub DeclarationModifiers declaration_modifiers(u32 flags, bool parameter) {
    return DeclarationModifiers {
        abi = empty_source_span(),
        is_public = parameter == false && (flags & u32(1)) != u32(0),
        is_comptime = (parameter && (flags & u32(1)) != u32(0))
            || (parameter == false && (flags & u32(2)) != u32(0)),
        is_constant = parameter == false && (flags & u32(4)) != u32(0),
        is_unsafe = (flags & u32(8)) != u32(0),
        is_extern = (flags & u32(16)) != u32(0),
        is_consuming = parameter && (flags & u32(2)) != u32(0),
        is_constructor = (flags & u32(32)) != u32(0),
        is_comptime_initializer = (flags & u32(64)) != u32(0),
        is_raises_inferred = (flags & u32(128)) != u32(0),
    };
}

pub struct ChildRange {
    usize start;
    usize length;
    usize len(&in self) { return self.length; }
    bool is_empty(&in self) { return self.length == usize(0); }
}

pub union SyntaxOperator {
    invalid;
    add;
    subtract;
    multiply;
    divide;
    remainder;
    equal;
    not_equal;
    less;
    less_equal;
    greater;
    greater_equal;
    logical_and;
    logical_or;
    bit_and;
    bit_or;
    bit_xor;
    bit_not;
    shift_left;
    shift_right;

    str spelling(&in self) {
        return match (&in self) {
            .invalid => "",
            .add => "+",
            .subtract => "-",
            .multiply => "*",
            .divide => "/",
            .remainder => "%",
            .equal => "==",
            .not_equal => "!=",
            .less => "<",
            .less_equal => "<=",
            .greater => ">",
            .greater_equal => ">=",
            .logical_and => "&&",
            .logical_or => "||",
            .bit_and => "&",
            .bit_or => "|",
            .bit_xor => "^",
            .bit_not => "~",
            .shift_left => "<<",
            .shift_right => ">>",
        };
    }
}

pub SyntaxOperator syntax_operator(&in SourceMap sources, SourceSpan span) raises SourceMapError {
    if (sources.text_equals(span, "+")) { return SyntaxOperator.add; }
    if (sources.text_equals(span, "-")) { return SyntaxOperator.subtract; }
    if (sources.text_equals(span, "*")) { return SyntaxOperator.multiply; }
    if (sources.text_equals(span, "/")) { return SyntaxOperator.divide; }
    if (sources.text_equals(span, "%")) { return SyntaxOperator.remainder; }
    if (sources.text_equals(span, "==")) { return SyntaxOperator.equal; }
    if (sources.text_equals(span, "!=")) { return SyntaxOperator.not_equal; }
    if (sources.text_equals(span, "<")) { return SyntaxOperator.less; }
    if (sources.text_equals(span, "<=")) { return SyntaxOperator.less_equal; }
    if (sources.text_equals(span, ">")) { return SyntaxOperator.greater; }
    if (sources.text_equals(span, ">=")) { return SyntaxOperator.greater_equal; }
    if (sources.text_equals(span, "&&")) { return SyntaxOperator.logical_and; }
    if (sources.text_equals(span, "||")) { return SyntaxOperator.logical_or; }
    if (sources.text_equals(span, "&")) { return SyntaxOperator.bit_and; }
    if (sources.text_equals(span, "|")) { return SyntaxOperator.bit_or; }
    if (sources.text_equals(span, "^")) { return SyntaxOperator.bit_xor; }
    if (sources.text_equals(span, "~")) { return SyntaxOperator.bit_not; }
    if (sources.text_equals(span, "<<")) { return SyntaxOperator.shift_left; }
    if (sources.text_equals(span, ">>")) { return SyntaxOperator.shift_right; }
    return SyntaxOperator.invalid;
}

pub union SyntaxData {
    invalid_declaration;
    invalid_statement;
    invalid_type;
    invalid_pattern;
    invalid_expression;
    module_declaration(SourceSpan path);
    import_declaration(SourceSpan path, SourceSpan alias, ChildRange symbols);
    import_path(SourceSpan name);
    import_symbol(SourceSpan name);
    struct_declaration(SourceSpan name, DeclarationModifiers modifiers, ChildRange parameters, NodeLink body);
    union_declaration(SourceSpan name, DeclarationModifiers modifiers, ChildRange parameters, NodeLink body);
    interface_declaration(SourceSpan name, DeclarationModifiers modifiers, NodeLink body);
    implementation_declaration(NodeLink target, NodeLink interface_type, NodeLink body);
    implementation_use(SourceSpan name);
    view_declaration(SourceSpan name, DeclarationModifiers modifiers, NodeLink body);
    view_field(SourceSpan name, SourceSpan mode, NodeLink declared_type);
    extern_type_declaration(SourceSpan name, DeclarationModifiers modifiers);
    function_declaration(SourceSpan name, DeclarationModifiers modifiers, NodeLink return_type, ChildRange parameters, ChildRange error_types, NodeLink body);
    parameter(SourceSpan name, DeclarationModifiers modifiers, NodeLink declared_type, ChildRange constraints);
    field_declaration(SourceSpan name, DeclarationModifiers modifiers, NodeLink declared_type, NodeLink initializer);
    variable_declaration(SourceSpan name, DeclarationModifiers modifiers, NodeLink declared_type, NodeLink initializer, ChildRange arguments);
    constant_declaration(SourceSpan name, DeclarationModifiers modifiers, NodeLink declared_type, NodeLink initializer);
    comptime_type_declaration(SourceSpan name, DeclarationModifiers modifiers, NodeLink initializer);
    union_variant(SourceSpan name, ChildRange parameters);
    block_statement(ChildRange statements);
    unsafe_block(ChildRange body);
    comptime_statement(NodeLink statement);
    expression_statement(NodeLink expression);
    assignment_statement(NodeLink target, NodeLink value);
    if_statement(ChildRange branches);
    if_branch(NodeLink condition, NodeLink body);
    else_branch(NodeLink body);
    while_statement(NodeLink condition, NodeLink body);
    for_statement(NodeLink initializer, NodeLink condition, NodeLink update, NodeLink body);
    try_statement(NodeLink body, ChildRange catches);
    catch_clause(SourceSpan name, NodeLink error_type, NodeLink body);
    return_statement(NodeLink value);
    raise_statement(NodeLink error);
    rethrow_statement;
    print_statement(NodeLink value);
    match_statement(NodeLink scrutinee, ChildRange arms);
    match_expression(NodeLink scrutinee, ChildRange arms);
    match_arm(NodeLink pattern, NodeLink body);
    variant_pattern(SourceSpan name, ChildRange bindings);
    wildcard_pattern;
    binding_pattern(SourceSpan name);
    named_type(SourceSpan name);
    generic_type(SourceSpan name, ChildRange arguments);
    array_type(NodeLink element, NodeLink extent);
    slice_type(NodeLink element);
    borrow_type(SourceSpan mode, NodeLink target);
    raw_pointer_type(SourceSpan mode, NodeLink target);
    nullable_pointer_type(SourceSpan mode, NodeLink target);
    type_argument(NodeLink value);
    name_expression(SourceSpan name);
    integer_literal(SourceSpan spelling);
    floating_literal(SourceSpan spelling);
    string_literal(SourceSpan spelling);
    formatted_string(ChildRange parts);
    formatted_text(SourceSpan spelling);
    boolean_literal(SourceSpan spelling);
    null_literal;
    unary_expression(SourceSpan operator, SyntaxOperator operation, NodeLink operand);
    binary_expression(SourceSpan operator, SyntaxOperator operation, NodeLink left, NodeLink right);
    borrow_expression(SourceSpan mode, NodeLink operand);
    move_expression(NodeLink operand);
    dereference_expression(NodeLink operand);
    call_expression(NodeLink callee, ChildRange arguments);
    member_expression(SourceSpan name, NodeLink receiver);
    index_expression(NodeLink target, NodeLink index);
    slice_expression(NodeLink target, NodeLink start, NodeLink end);
    struct_literal(NodeLink declared_type, ChildRange fields);
    struct_literal_field(SourceSpan name, NodeLink value);
    union_variant_expression(SourceSpan name, ChildRange arguments);
    parenthesized_expression(NodeLink expression);
    absent;
}

// Draft records exist only while the parser constructs a typed node.
pub union NodeDraft {
    operator(SourceSpan text, SyntaxOperator operation, ChildRange children);
    metadata(SourceSpan text, SourceSpan extra, u32 value, ChildRange children);
    none;
    text(SourceSpan value);
    children(ChildRange value);
    text_value_children(SourceSpan text, u32 value, ChildRange children);
}

pub struct SyntaxNode {
    usize ordinal;
    SourceSpan span;
    SyntaxData data;

    SourceSpan source_span(&in self) { return self.span; }
    SyntaxKind kind(&in self) {
        return match (&in self.data) {
            .invalid_declaration => SyntaxKind.invalid_declaration,
            .invalid_statement => SyntaxKind.invalid_statement,
            .invalid_type => SyntaxKind.invalid_type,
            .invalid_pattern => SyntaxKind.invalid_pattern,
            .invalid_expression => SyntaxKind.invalid_expression,
            .module_declaration(_) => SyntaxKind.module_declaration,
            .import_declaration(_, _, _) => SyntaxKind.import_declaration,
            .import_path(_) => SyntaxKind.import_path,
            .import_symbol(_) => SyntaxKind.import_symbol,
            .struct_declaration(_, _, _, _) => SyntaxKind.struct_declaration,
            .union_declaration(_, _, _, _) => SyntaxKind.union_declaration,
            .interface_declaration(_, _, _) => SyntaxKind.interface_declaration,
            .implementation_declaration(_, _, _) => SyntaxKind.implementation_declaration,
            .implementation_use(_) => SyntaxKind.implementation_use,
            .view_declaration(_, _, _) => SyntaxKind.view_declaration,
            .view_field(_, _, _) => SyntaxKind.view_field,
            .extern_type_declaration(_, _) => SyntaxKind.extern_type_declaration,
            .function_declaration(_, _, _, _, _, _) => SyntaxKind.function_declaration,
            .parameter(_, _, _, _) => SyntaxKind.parameter,
            .field_declaration(_, _, _, _) => SyntaxKind.field_declaration,
            .variable_declaration(_, _, _, _, _) => SyntaxKind.variable_declaration,
            .constant_declaration(_, _, _, _) => SyntaxKind.constant_declaration,
            .comptime_type_declaration(_, _, _) => SyntaxKind.comptime_type_declaration,
            .union_variant(_, _) => SyntaxKind.union_variant,
            .block_statement(_) => SyntaxKind.block_statement,
            .unsafe_block(_) => SyntaxKind.unsafe_block,
            .comptime_statement(_) => SyntaxKind.comptime_statement,
            .expression_statement(_) => SyntaxKind.expression_statement,
            .assignment_statement(_, _) => SyntaxKind.assignment_statement,
            .if_statement(_) => SyntaxKind.if_statement,
            .if_branch(_, _) => SyntaxKind.if_branch,
            .else_branch(_) => SyntaxKind.else_branch,
            .while_statement(_, _) => SyntaxKind.while_statement,
            .for_statement(_, _, _, _) => SyntaxKind.for_statement,
            .try_statement(_, _) => SyntaxKind.try_statement,
            .catch_clause(_, _, _) => SyntaxKind.catch_clause,
            .return_statement(_) => SyntaxKind.return_statement,
            .raise_statement(_) => SyntaxKind.raise_statement,
            .rethrow_statement => SyntaxKind.rethrow_statement,
            .print_statement(_) => SyntaxKind.print_statement,
            .match_statement(_, _) => SyntaxKind.match_statement,
            .match_expression(_, _) => SyntaxKind.match_expression,
            .match_arm(_, _) => SyntaxKind.match_arm,
            .variant_pattern(_, _) => SyntaxKind.variant_pattern,
            .wildcard_pattern => SyntaxKind.wildcard_pattern,
            .binding_pattern(_) => SyntaxKind.binding_pattern,
            .named_type(_) => SyntaxKind.named_type,
            .generic_type(_, _) => SyntaxKind.generic_type,
            .array_type(_, _) => SyntaxKind.array_type,
            .slice_type(_) => SyntaxKind.slice_type,
            .borrow_type(_, _) => SyntaxKind.borrow_type,
            .raw_pointer_type(_, _) => SyntaxKind.raw_pointer_type,
            .nullable_pointer_type(_, _) => SyntaxKind.nullable_pointer_type,
            .type_argument(_) => SyntaxKind.type_argument,
            .name_expression(_) => SyntaxKind.name_expression,
            .integer_literal(_) => SyntaxKind.integer_literal,
            .floating_literal(_) => SyntaxKind.floating_literal,
            .string_literal(_) => SyntaxKind.string_literal,
            .formatted_string(_) => SyntaxKind.formatted_string,
            .formatted_text(_) => SyntaxKind.formatted_text,
            .boolean_literal(_) => SyntaxKind.boolean_literal,
            .null_literal => SyntaxKind.null_literal,
            .unary_expression(_, _, _) => SyntaxKind.unary_expression,
            .binary_expression(_, _, _, _) => SyntaxKind.binary_expression,
            .borrow_expression(_, _) => SyntaxKind.borrow_expression,
            .move_expression(_) => SyntaxKind.move_expression,
            .dereference_expression(_) => SyntaxKind.dereference_expression,
            .call_expression(_, _) => SyntaxKind.call_expression,
            .member_expression(_, _) => SyntaxKind.member_expression,
            .index_expression(_, _) => SyntaxKind.index_expression,
            .slice_expression(_, _, _) => SyntaxKind.slice_expression,
            .struct_literal(_, _) => SyntaxKind.struct_literal,
            .struct_literal_field(_, _) => SyntaxKind.struct_literal_field,
            .union_variant_expression(_, _) => SyntaxKind.union_variant_expression,
            .parenthesized_expression(_) => SyntaxKind.parenthesized_expression,
            .absent => SyntaxKind.absent,
        };
    }
    str kind_name(&in self) {
        return match (&in self.data) {
            .invalid_declaration => "invalid_declaration",
            .invalid_statement => "invalid_statement",
            .invalid_type => "invalid_type",
            .invalid_pattern => "invalid_pattern",
            .invalid_expression => "invalid_expression",
            .module_declaration(_) => "module_declaration",
            .import_declaration(_, _, _) => "import_declaration",
            .import_path(_) => "import_path",
            .import_symbol(_) => "import_symbol",
            .struct_declaration(_, _, _, _) => "struct_declaration",
            .union_declaration(_, _, _, _) => "union_declaration",
            .interface_declaration(_, _, _) => "interface_declaration",
            .implementation_declaration(_, _, _) => "implementation_declaration",
            .implementation_use(_) => "implementation_use",
            .view_declaration(_, _, _) => "view_declaration",
            .view_field(_, _, _) => "view_field",
            .extern_type_declaration(_, _) => "extern_type_declaration",
            .function_declaration(_, _, _, _, _, _) => "function_declaration",
            .parameter(_, _, _, _) => "parameter",
            .field_declaration(_, _, _, _) => "field_declaration",
            .variable_declaration(_, _, _, _, _) => "variable_declaration",
            .constant_declaration(_, _, _, _) => "constant_declaration",
            .comptime_type_declaration(_, _, _) => "comptime_type_declaration",
            .union_variant(_, _) => "union_variant",
            .block_statement(_) => "block_statement",
            .unsafe_block(_) => "unsafe_block",
            .comptime_statement(_) => "comptime_statement",
            .expression_statement(_) => "expression_statement",
            .assignment_statement(_, _) => "assignment_statement",
            .if_statement(_) => "if_statement",
            .if_branch(_, _) => "if_branch",
            .else_branch(_) => "else_branch",
            .while_statement(_, _) => "while_statement",
            .for_statement(_, _, _, _) => "for_statement",
            .try_statement(_, _) => "try_statement",
            .catch_clause(_, _, _) => "catch_clause",
            .return_statement(_) => "return_statement",
            .raise_statement(_) => "raise_statement",
            .rethrow_statement => "rethrow_statement",
            .print_statement(_) => "print_statement",
            .match_statement(_, _) => "match_statement",
            .match_expression(_, _) => "match_expression",
            .match_arm(_, _) => "match_arm",
            .variant_pattern(_, _) => "variant_pattern",
            .wildcard_pattern => "wildcard_pattern",
            .binding_pattern(_) => "binding_pattern",
            .named_type(_) => "named_type",
            .generic_type(_, _) => "generic_type",
            .array_type(_, _) => "array_type",
            .slice_type(_) => "slice_type",
            .borrow_type(_, _) => "borrow_type",
            .raw_pointer_type(_, _) => "raw_pointer_type",
            .nullable_pointer_type(_, _) => "nullable_pointer_type",
            .type_argument(_) => "type_argument",
            .name_expression(_) => "name_expression",
            .integer_literal(_) => "integer_literal",
            .floating_literal(_) => "floating_literal",
            .string_literal(_) => "string_literal",
            .formatted_string(_) => "formatted_string",
            .formatted_text(_) => "formatted_text",
            .boolean_literal(_) => "boolean_literal",
            .null_literal => "null_literal",
            .unary_expression(_, _, _) => "unary_expression",
            .binary_expression(_, _, _, _) => "binary_expression",
            .borrow_expression(_, _) => "borrow_expression",
            .move_expression(_) => "move_expression",
            .dereference_expression(_) => "dereference_expression",
            .call_expression(_, _) => "call_expression",
            .member_expression(_, _) => "member_expression",
            .index_expression(_, _) => "index_expression",
            .slice_expression(_, _, _) => "slice_expression",
            .struct_literal(_, _) => "struct_literal",
            .struct_literal_field(_, _) => "struct_literal_field",
            .union_variant_expression(_, _) => "union_variant_expression",
            .parenthesized_expression(_) => "parenthesized_expression",
            .absent => "absent",
        };
    }
    &in SyntaxData payload(&in self) { return &in self.data; }
}
pub struct SyntaxBuilder {
    SourceId source;
    bool errors;
    usize scratch_high_water;
    usize scratch_capacity;
    Vector(Token, SystemAllocator) tokens;
    Arena(SyntaxNode, SystemAllocator) nodes;
    Vector(ArenaHandle(SyntaxNode), SystemAllocator) links;
    Vector(ArenaHandle(SyntaxNode), SystemAllocator) roots;

    init(
        &inout self,
        SourceId source,
        move Vector(Token, SystemAllocator) tokens
    ) raises CapacityError, LayoutError, AllocationError {
        self.source = source;
        self.errors = false;
        self.scratch_high_water = usize(0);
        self.scratch_capacity = usize(0);
        self.tokens = move tokens;
        SystemAllocator node_allocator;
        Arena(SyntaxNode, SystemAllocator) nodes(
            node_allocator, self.tokens.len()
        );
        self.nodes = move nodes;
        SystemAllocator link_allocator;
        Vector(ArenaHandle(SyntaxNode), SystemAllocator) links(
            link_allocator, self.tokens.len()
        );
        self.links = move links;
        SystemAllocator root_allocator;
        Vector(ArenaHandle(SyntaxNode), SystemAllocator) roots(
            root_allocator, usize(0)
        );
        self.roots = move roots;
    }

    bool has_errors(&in self) { return self.errors; }
    void set_errors(&inout self, bool value) { self.errors = value; }
    void set_scratch_statistics(&inout self, usize peak, usize capacity) {
        self.scratch_high_water = peak;
        self.scratch_capacity = capacity;
    }

    SourceId source_id(&in self) { return self.source; }
    usize token_count(&in self) { return self.tokens.len(); }
    usize append_tokens(&inout self, &in Vector(Token, SystemAllocator) tokens)
        raises CapacityError, LayoutError, AllocationError, BoundsError {
        usize start = self.tokens.len();
        usize index = usize(0);
        while (index < tokens.len()) {
            self.tokens.push(tokens.get(index));
            index = index + usize(1);
        }
        return start;
    }
    &in Token token(&in self, usize index) raises BoundsError {
        return self.tokens.get(index);
    }
    usize node_count(&in self) { return self.nodes.len(); }
    &in SyntaxNode node(&in self, ArenaHandle(SyntaxNode) handle)
        raises ArenaHandleError
    {
        return self.nodes.get(handle);
    }
    usize root_count(&in self) { return self.roots.len(); }
    ArenaHandle(SyntaxNode) root(&in self, usize index) raises BoundsError {
        return self.roots.get(index);
    }
    ArenaHandle(SyntaxNode) child(&in self, ChildRange range, usize index)
        raises BoundsError
    {
        if (index >= range.length) { raise BoundsError { }; }
        return self.links.get(range.start + index);
    }

    usize begin_children(&in self) { return self.links.len(); }
    void append_child(&inout self, ArenaHandle(SyntaxNode) child)
        raises CapacityError, LayoutError, AllocationError
    {
        self.links.push(child);
    }
    ChildRange finish_children(&in self, usize start) {
        return ChildRange { start = start, length = self.links.len() - start };
    }
    ArenaHandle(SyntaxNode) insert(&inout self, move SyntaxNode node)
        raises CapacityError, LayoutError, AllocationError
    {
        node.ordinal = self.nodes.len();
        return self.nodes.insert(node);
    }
    void append_root(&inout self, ArenaHandle(SyntaxNode) root)
        raises CapacityError, LayoutError, AllocationError
    {
        self.roots.push(root);
    }
}

pub struct ParsedFile {
    SyntaxBuilder storage;

    init(&inout self, move SyntaxBuilder storage) { self.storage = move storage; }
    bool has_errors(&in self) { return self.storage.has_errors(); }
    usize node_size(&in self) { return sizeof(SyntaxNode); }
    usize link_count(&in self) { return self.storage.links.len(); }
    usize scratch_peak(&in self) { return self.storage.scratch_high_water; }
    usize scratch_capacity(&in self) { return self.storage.scratch_capacity; }
    usize retained_bytes(&in self) {
        return self.storage.tokens.capacity() * sizeof(Token)
            + self.storage.nodes.capacity() * sizeof(SyntaxNode)
            + self.storage.links.capacity() * sizeof(ArenaHandle(SyntaxNode))
            + self.storage.roots.capacity() * sizeof(ArenaHandle(SyntaxNode));
    }
    SourceId source_id(&in self) { return self.storage.source_id(); }
    usize token_count(&in self) { return self.storage.token_count(); }
    &in Token token(&in self, usize index) raises BoundsError {
        return self.storage.token(index);
    }
    usize node_count(&in self) { return self.storage.node_count(); }
    &in SyntaxNode node(&in self, ArenaHandle(SyntaxNode) handle)
        raises ArenaHandleError { return self.storage.node(handle); }
    usize root_count(&in self) { return self.storage.root_count(); }
    ArenaHandle(SyntaxNode) root(&in self, usize index) raises BoundsError {
        return self.storage.root(index);
    }
    ArenaHandle(SyntaxNode) child(&in self, ChildRange range, usize index)
        raises BoundsError { return self.storage.child(range, index); }
}

pub usize child_count(&in SyntaxNode node) {
    usize count = usize(0);
    match (&in node.data) {
        .invalid_declaration {

        }
        .invalid_statement {

        }
        .invalid_type {

        }
        .invalid_pattern {

        }
        .invalid_expression {

        }
        .module_declaration(path) {

        }
        .import_declaration(path, alias, symbols) {
            count = count + symbols.len();
        }
        .import_path(name) {

        }
        .import_symbol(name) {

        }
        .struct_declaration(name, modifiers, parameters, body) {
            count = count + parameters.len();
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .union_declaration(name, modifiers, parameters, body) {
            count = count + parameters.len();
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .interface_declaration(name, modifiers, body) {
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .implementation_declaration(target, interface_type, body) {
            match (target) { .absent { } .present(_) { count = count + usize(1); } }
            match (interface_type) { .absent { } .present(_) { count = count + usize(1); } }
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .implementation_use(name) {

        }
        .view_declaration(name, modifiers, body) {
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .view_field(name, mode, declared_type) {
            match (declared_type) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .extern_type_declaration(name, modifiers) {

        }
        .function_declaration(name, modifiers, return_type, parameters, error_types, body) {
            match (return_type) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + parameters.len();
            count = count + error_types.len();
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .parameter(name, modifiers, declared_type, constraints) {
            match (declared_type) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + constraints.len();
        }
        .field_declaration(name, modifiers, declared_type, initializer) {
            match (declared_type) { .absent { } .present(_) { count = count + usize(1); } }
            match (initializer) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .variable_declaration(name, modifiers, declared_type, initializer, arguments) {
            match (declared_type) { .absent { } .present(_) { count = count + usize(1); } }
            match (initializer) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + arguments.len();
        }
        .constant_declaration(name, modifiers, declared_type, initializer) {
            match (declared_type) { .absent { } .present(_) { count = count + usize(1); } }
            match (initializer) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .comptime_type_declaration(name, modifiers, initializer) {
            match (initializer) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .union_variant(name, parameters) {
            count = count + parameters.len();
        }
        .block_statement(statements) {
            count = count + statements.len();
        }
        .unsafe_block(body) {
            count = count + body.len();
        }
        .comptime_statement(statement) {
            match (statement) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .expression_statement(expression) {
            match (expression) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .assignment_statement(target, value) {
            match (target) { .absent { } .present(_) { count = count + usize(1); } }
            match (value) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .if_statement(branches) {
            count = count + branches.len();
        }
        .if_branch(condition, body) {
            match (condition) { .absent { } .present(_) { count = count + usize(1); } }
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .else_branch(body) {
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .while_statement(condition, body) {
            match (condition) { .absent { } .present(_) { count = count + usize(1); } }
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .for_statement(initializer, condition, update, body) {
            match (initializer) { .absent { } .present(_) { count = count + usize(1); } }
            match (condition) { .absent { } .present(_) { count = count + usize(1); } }
            match (update) { .absent { } .present(_) { count = count + usize(1); } }
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .try_statement(body, catches) {
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + catches.len();
        }
        .catch_clause(name, error_type, body) {
            match (error_type) { .absent { } .present(_) { count = count + usize(1); } }
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .return_statement(value) {
            match (value) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .raise_statement(error) {
            match (error) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .rethrow_statement {

        }
        .print_statement(value) {
            match (value) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .match_statement(scrutinee, arms) {
            match (scrutinee) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + arms.len();
        }
        .match_expression(scrutinee, arms) {
            match (scrutinee) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + arms.len();
        }
        .match_arm(pattern, body) {
            match (pattern) { .absent { } .present(_) { count = count + usize(1); } }
            match (body) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .variant_pattern(name, bindings) {
            count = count + bindings.len();
        }
        .wildcard_pattern {

        }
        .binding_pattern(name) {

        }
        .named_type(name) {

        }
        .generic_type(name, arguments) {
            count = count + arguments.len();
        }
        .array_type(element, extent) {
            match (element) { .absent { } .present(_) { count = count + usize(1); } }
            match (extent) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .slice_type(element) {
            match (element) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .borrow_type(mode, target) {
            match (target) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .raw_pointer_type(mode, target) {
            match (target) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .nullable_pointer_type(mode, target) {
            match (target) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .type_argument(value) {
            match (value) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .name_expression(name) {

        }
        .integer_literal(spelling) {

        }
        .floating_literal(spelling) {

        }
        .string_literal(spelling) {

        }
        .formatted_string(parts) {
            count = count + parts.len();
        }
        .formatted_text(spelling) {

        }
        .boolean_literal(spelling) {

        }
        .null_literal {

        }
        .unary_expression(operator, operation, operand) {
            match (operand) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .binary_expression(operator, operation, left, right) {
            match (left) { .absent { } .present(_) { count = count + usize(1); } }
            match (right) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .borrow_expression(mode, operand) {
            match (operand) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .move_expression(operand) {
            match (operand) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .dereference_expression(operand) {
            match (operand) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .call_expression(callee, arguments) {
            match (callee) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + arguments.len();
        }
        .member_expression(name, receiver) {
            match (receiver) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .index_expression(target, index) {
            match (target) { .absent { } .present(_) { count = count + usize(1); } }
            match (index) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .slice_expression(target, start, end) {
            match (target) { .absent { } .present(_) { count = count + usize(1); } }
            match (start) { .absent { } .present(_) { count = count + usize(1); } }
            match (end) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .struct_literal(declared_type, fields) {
            match (declared_type) { .absent { } .present(_) { count = count + usize(1); } }
            count = count + fields.len();
        }
        .struct_literal_field(name, value) {
            match (value) { .absent { } .present(_) { count = count + usize(1); } }
        }
        .union_variant_expression(name, arguments) {
            count = count + arguments.len();
        }
        .parenthesized_expression(expression) {
            match (expression) { .absent { } .present(_) { count = count + usize(1); } }
        }
