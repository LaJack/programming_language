NodeLink draft_child(&in SyntaxBuilder builder, ChildRange range, usize index)
    raises BoundsError, ArenaHandleError {
    if (index >= range.len()) { return NodeLink.absent; }
    ArenaHandle(SyntaxNode) handle = builder.child(range, index);
    &in SyntaxNode node = builder.node(handle);
    if (node.kind() == SyntaxKind.absent) { return NodeLink.absent; }
    return NodeLink.present(handle);
}

ChildRange subrange(ChildRange range, usize start, usize end) {
    return ChildRange { start = range.start + start, length = end - start };
}

pub SyntaxNode materialize_node(
    &inout SyntaxBuilder builder, SyntaxKind kind, SourceSpan span, NodeDraft draft
) raises BoundsError, ArenaHandleError {
    SourceSpan text = span;
    SourceSpan extra = source_span(span.source_id(), span.start_offset(), span.start_offset(),
        span.line_number(), span.column_number());
    u32 flags = u32(0);
    SyntaxOperator operation = SyntaxOperator.invalid;
    ChildRange children = ChildRange { start = usize(0), length = usize(0) };
    match (&in draft) {
        .operator(value, op, range) { text = value; operation = op; children = range; }
        .metadata(value, additional, modifiers, range) {
            text = value; extra = additional; flags = modifiers; children = range;
        }
        .none { }
        .text(value) { text = value; }
        .children(value) { children = value; }
        .text_value_children(value, modifiers, range) {
            text = value; flags = modifiers; children = range;
        }
    }
    usize last = usize(0);
    if (children.len() > usize(0)) { last = children.len() - usize(1); }
    usize tail = usize(0);
    if (children.len() > usize(0)) { tail = usize(1); }
    usize param_start = usize(0);
    usize param_end = usize(0);
    usize raises_end = children.len();
    bool has_return_type = false;
    bool has_body = false;
    if (kind == SyntaxKind.function_declaration) {
        if (children.len() > usize(0)) {
            ArenaHandle(SyntaxNode) first_handle = builder.child(children, usize(0));
            &in SyntaxNode first = builder.node(first_handle);
            if (first.kind() != SyntaxKind.parameter && first.kind() != SyntaxKind.block_statement) {
                has_return_type = true; param_start = usize(1);
            }
            ArenaHandle(SyntaxNode) last_handle = builder.child(children, last);
            &in SyntaxNode end = builder.node(last_handle);
            has_body = end.kind() == SyntaxKind.block_statement;
            if (has_body) { raises_end = last; }
        }
        param_end = param_start;
        bool scanning = true;
        while (param_end < raises_end && scanning) {
            ArenaHandle(SyntaxNode) handle = builder.child(children, param_end);
            &in SyntaxNode child = builder.node(handle);
            if (child.kind() == SyntaxKind.parameter) { param_end = param_end + usize(1); }
            else { scanning = false; }
        }
    }
    NodeLink return_type = NodeLink.absent;
    NodeLink body = NodeLink.absent;
    NodeLink initializer = NodeLink.absent;
    ChildRange arguments = subrange(children, children.len(), children.len());
    if (has_return_type) { return_type = draft_child(builder, children, usize(0)); }
    if (has_body) { body = draft_child(builder, children, last); }
    if ((flags & u32(32)) != u32(0)) { arguments = subrange(children, tail, children.len()); }
    else { initializer = draft_child(builder, children, usize(1)); }
    DeclarationModifiers modifiers = declaration_modifiers(flags, false);
    modifiers.abi = extra;
    SyntaxData data = match (&in kind) {
        .invalid_declaration => SyntaxData.invalid_declaration,
        .invalid_statement => SyntaxData.invalid_statement,
        .invalid_type => SyntaxData.invalid_type,
        .invalid_pattern => SyntaxData.invalid_pattern,
        .invalid_expression => SyntaxData.invalid_expression,
        .module_declaration => SyntaxData.module_declaration(text),
        .import_declaration => SyntaxData.import_declaration(text, extra, children),
        .import_path => SyntaxData.import_path(text),
        .import_symbol => SyntaxData.import_symbol(text),
        .struct_declaration => SyntaxData.struct_declaration(text, modifiers, subrange(children, usize(0), last), draft_child(builder, children, last)),
        .union_declaration => SyntaxData.union_declaration(text, modifiers, subrange(children, usize(0), last), draft_child(builder, children, last)),
        .interface_declaration => SyntaxData.interface_declaration(text, modifiers, draft_child(builder, children, last)),
        .implementation_declaration => SyntaxData.implementation_declaration(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1)), draft_child(builder, children, usize(2))),
        .implementation_use => SyntaxData.implementation_use(text),
        .view_declaration => SyntaxData.view_declaration(text, modifiers, draft_child(builder, children, last)),
        .view_field => SyntaxData.view_field(text, extra, draft_child(builder, children, usize(0))),
        .extern_type_declaration => SyntaxData.extern_type_declaration(text, modifiers),
        .function_declaration => SyntaxData.function_declaration(text, modifiers, return_type, subrange(children, param_start, param_end), subrange(children, param_end, raises_end), body),
        .parameter => SyntaxData.parameter(text, declaration_modifiers(flags, true), draft_child(builder, children, usize(0)), subrange(children, tail, children.len())),
        .field_declaration => SyntaxData.field_declaration(text, modifiers, draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .variable_declaration => SyntaxData.variable_declaration(text, modifiers, draft_child(builder, children, usize(0)), initializer, arguments),
        .constant_declaration => SyntaxData.constant_declaration(text, modifiers, draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .comptime_type_declaration => SyntaxData.comptime_type_declaration(text, modifiers, draft_child(builder, children, usize(0))),
        .union_variant => SyntaxData.union_variant(text, children),
        .block_statement => SyntaxData.block_statement(children),
        .unsafe_block => SyntaxData.unsafe_block(children),
        .comptime_statement => SyntaxData.comptime_statement(draft_child(builder, children, usize(0))),
        .expression_statement => SyntaxData.expression_statement(draft_child(builder, children, usize(0))),
        .assignment_statement => SyntaxData.assignment_statement(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .if_statement => SyntaxData.if_statement(children),
        .if_branch => SyntaxData.if_branch(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .else_branch => SyntaxData.else_branch(draft_child(builder, children, usize(0))),
        .while_statement => SyntaxData.while_statement(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .for_statement => SyntaxData.for_statement(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1)), draft_child(builder, children, usize(2)), draft_child(builder, children, usize(3))),
        .try_statement => SyntaxData.try_statement(draft_child(builder, children, usize(0)), subrange(children, tail, children.len())),
        .catch_clause => SyntaxData.catch_clause(text, draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .return_statement => SyntaxData.return_statement(draft_child(builder, children, usize(0))),
        .raise_statement => SyntaxData.raise_statement(draft_child(builder, children, usize(0))),
        .rethrow_statement => SyntaxData.rethrow_statement,
        .print_statement => SyntaxData.print_statement(draft_child(builder, children, usize(0))),
        .match_statement => SyntaxData.match_statement(draft_child(builder, children, usize(0)), subrange(children, tail, children.len())),
        .match_expression => SyntaxData.match_expression(draft_child(builder, children, usize(0)), subrange(children, tail, children.len())),
        .match_arm => SyntaxData.match_arm(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .variant_pattern => SyntaxData.variant_pattern(text, children),
        .wildcard_pattern => SyntaxData.wildcard_pattern,
        .binding_pattern => SyntaxData.binding_pattern(text),
        .named_type => SyntaxData.named_type(text),
        .generic_type => SyntaxData.generic_type(text, children),
        .array_type => SyntaxData.array_type(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .slice_type => SyntaxData.slice_type(draft_child(builder, children, usize(0))),
        .borrow_type => SyntaxData.borrow_type(text, draft_child(builder, children, usize(0))),
        .raw_pointer_type => SyntaxData.raw_pointer_type(text, draft_child(builder, children, usize(0))),
        .nullable_pointer_type => SyntaxData.nullable_pointer_type(text, draft_child(builder, children, usize(0))),
        .type_argument => SyntaxData.type_argument(draft_child(builder, children, usize(0))),
        .name_expression => SyntaxData.name_expression(text),
        .integer_literal => SyntaxData.integer_literal(text),
        .floating_literal => SyntaxData.floating_literal(text),
        .string_literal => SyntaxData.string_literal(text),
        .formatted_string => SyntaxData.formatted_string(children),
        .formatted_text => SyntaxData.formatted_text(text),
        .boolean_literal => SyntaxData.boolean_literal(text),
        .null_literal => SyntaxData.null_literal,
        .unary_expression => SyntaxData.unary_expression(text, operation, draft_child(builder, children, usize(0))),
        .binary_expression => SyntaxData.binary_expression(text, operation, draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .borrow_expression => SyntaxData.borrow_expression(text, draft_child(builder, children, usize(0))),
        .move_expression => SyntaxData.move_expression(draft_child(builder, children, usize(0))),
        .dereference_expression => SyntaxData.dereference_expression(draft_child(builder, children, usize(0))),
        .call_expression => SyntaxData.call_expression(draft_child(builder, children, usize(0)), subrange(children, tail, children.len())),
        .member_expression => SyntaxData.member_expression(text, draft_child(builder, children, usize(0))),
        .index_expression => SyntaxData.index_expression(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1))),
        .slice_expression => SyntaxData.slice_expression(draft_child(builder, children, usize(0)), draft_child(builder, children, usize(1)), draft_child(builder, children, usize(2))),
        .struct_literal => SyntaxData.struct_literal(draft_child(builder, children, usize(0)), subrange(children, tail, children.len())),
        .struct_literal_field => SyntaxData.struct_literal_field(text, draft_child(builder, children, usize(0))),
        .union_variant_expression => SyntaxData.union_variant_expression(text, children),
        .parenthesized_expression => SyntaxData.parenthesized_expression(draft_child(builder, children, usize(0))),
        .absent => SyntaxData.absent,
    };
    if (children.len() > usize(0)) { compact_draft_links(builder, children, data); }
    return make_syntax_node(span, data);
}

// Only the freshly appended draft tail is rewritten. Older nodes keep their ranges.
void compact_range(&inout SyntaxBuilder builder, &inout ChildRange range, &inout usize write)
    raises BoundsError {
    usize start = write;
    usize index = usize(0);
    while (index < range.length) {
        ArenaHandle(SyntaxNode) handle = builder.links.get(range.start + index);
        &inout ArenaHandle(SyntaxNode) slot = builder.links.get_mut(write);
        slot = handle;
        write = write + usize(1);
        index = index + usize(1);
    }
    range.start = start;
}

void compact_draft_links(&inout SyntaxBuilder builder, ChildRange draft, &inout SyntaxData data)
    raises BoundsError {
    if (draft.start + draft.length != builder.links.len()) { raise BoundsError { }; }
    usize write = draft.start;
    match (data) {
        .import_declaration(_, _, symbols) { compact_range(builder, symbols, write); }
        .struct_declaration(_, _, parameters, _) { compact_range(builder, parameters, write); }
        .union_declaration(_, _, parameters, _) { compact_range(builder, parameters, write); }
        .function_declaration(_, _, _, parameters, errors, _) {
            compact_range(builder, parameters, write);
            compact_range(builder, errors, write);
        }
        .parameter(_, _, _, constraints) { compact_range(builder, constraints, write); }
        .variable_declaration(_, _, _, _, arguments) { compact_range(builder, arguments, write); }
        .union_variant(_, parameters) { compact_range(builder, parameters, write); }
        .block_statement(statements) { compact_range(builder, statements, write); }
        .unsafe_block(body) { compact_range(builder, body, write); }
        .if_statement(branches) { compact_range(builder, branches, write); }
        .try_statement(_, catches) { compact_range(builder, catches, write); }
        .match_statement(_, arms) { compact_range(builder, arms, write); }
        .match_expression(_, arms) { compact_range(builder, arms, write); }
        .variant_pattern(_, bindings) { compact_range(builder, bindings, write); }
        .generic_type(_, arguments) { compact_range(builder, arguments, write); }
        .formatted_string(parts) { compact_range(builder, parts, write); }
        .call_expression(_, arguments) { compact_range(builder, arguments, write); }
        .struct_literal(_, fields) { compact_range(builder, fields, write); }
        .union_variant_expression(_, arguments) { compact_range(builder, arguments, write); }
        _ { }
    }
    while (builder.links.len() > write) { builder.links.pop(); }
}

pub SyntaxNode make_syntax_node(SourceSpan span, SyntaxData data) {
    return SyntaxNode { ordinal = usize(0), span = span, data = data };
}

pub struct SyntaxValidationError { }

bool kind_is_type(SyntaxKind kind) {
    return match (&in kind) {
        .named_type => true, .generic_type => true, .array_type => true,
        .slice_type => true, .borrow_type => true, .raw_pointer_type => true,
        .nullable_pointer_type => true, .invalid_type => true,
        _ => false,
    };
}

bool kind_is_expression(SyntaxKind kind) {
    return match (&in kind) {
        .invalid_expression => true,
        .match_expression => true,
        .name_expression => true,
        .integer_literal => true,
        .floating_literal => true,
        .string_literal => true,
        .formatted_string => true,
        .boolean_literal => true,
        .null_literal => true,
        .unary_expression => true,
        .binary_expression => true,
        .borrow_expression => true,
        .move_expression => true,
        .dereference_expression => true,
        .call_expression => true,
        .member_expression => true,
        .index_expression => true,
        .slice_expression => true,
        .struct_literal => true,
        .union_variant_expression => true,
        .parenthesized_expression => true,
        _ => false,
    };
}

bool category_matches(SyntaxKind kind, str category) {
    if (category == "type") { return kind_is_type(kind); }
    if (category == "expression") { return kind_is_expression(kind); }
    if (category == "type_or_expression") {
        return kind_is_type(kind) || kind_is_expression(kind) || kind == SyntaxKind.parameter;
    }
    if (category == "block") {
        return kind == SyntaxKind.block_statement || kind == SyntaxKind.invalid_statement;
    }
    if (category == "arm_body") {
        return kind == SyntaxKind.block_statement || kind == SyntaxKind.invalid_statement
            || kind_is_expression(kind);
    }
    if (category == "parameter") { return kind == SyntaxKind.parameter || kind == SyntaxKind.invalid_declaration; }
    if (category == "pattern") {
        return kind == SyntaxKind.variant_pattern || kind == SyntaxKind.wildcard_pattern
            || kind == SyntaxKind.invalid_pattern;
    }
    if (category == "binding") {
        return kind == SyntaxKind.binding_pattern || kind == SyntaxKind.wildcard_pattern
            || kind == SyntaxKind.invalid_pattern;
    }
    if (category == "arm") { return kind == SyntaxKind.match_arm; }
    if (category == "branch") { return kind == SyntaxKind.if_branch || kind == SyntaxKind.else_branch; }
    if (category == "catch") { return kind == SyntaxKind.catch_clause; }
    if (category == "import_symbol") { return kind == SyntaxKind.import_symbol; }
    if (category == "field_value") { return kind == SyntaxKind.struct_literal_field; }
    if (category == "formatted_part") { return kind == SyntaxKind.formatted_text || kind_is_expression(kind); }
    if (category == "statement") {
        return match (&in kind) {
            .invalid_declaration => true,
            .invalid_statement => true,
            .module_declaration => true,
            .import_declaration => true,
            .struct_declaration => true,
            .union_declaration => true,
            .interface_declaration => true,
            .implementation_declaration => true,
            .implementation_use => true,
            .view_declaration => true,
            .view_field => true,
            .extern_type_declaration => true,
            .function_declaration => true,
            .field_declaration => true,
            .variable_declaration => true,
            .constant_declaration => true,
            .comptime_type_declaration => true,
            .union_variant => true,
            .block_statement => true,
            .unsafe_block => true,
            .comptime_statement => true,
            .expression_statement => true,
            .assignment_statement => true,
            .if_statement => true,
            .while_statement => true,
            .for_statement => true,
            .try_statement => true,
            .return_statement => true,
            .raise_statement => true,
            .rethrow_statement => true,
            .print_statement => true,
            .match_statement => true,
            _ => false,
        };
    }
    return false;
}

void validate_edge(&in ParsedFile file, &in SyntaxNode parent,
    ArenaHandle(SyntaxNode) handle, str category)
    raises SyntaxValidationError, ArenaHandleError {
    &in SyntaxNode child = file.node(handle);
    if (child.ordinal >= parent.ordinal || category_matches(child.kind(), category) == false
        || child.span.start_offset() < parent.span.start_offset()
        || child.span.end_offset() > parent.span.end_offset()) {
        raise SyntaxValidationError { };
    }
    SourceSpan span = child.source_span();
    if (span.start_offset() < parent.span.start_offset()
        || span.end_offset() > parent.span.end_offset()) { raise SyntaxValidationError { }; }
}

void validate_link(&in ParsedFile file, &in SyntaxNode parent,
    &in NodeLink link, str category, bool optional)
    raises SyntaxValidationError, ArenaHandleError {
    match (link) {
        .absent { if (optional == false) { raise SyntaxValidationError { }; } }
        .present(handle) { validate_edge(file, parent, handle, category); }
    }
}

void validate_range(&in ParsedFile file, &in SyntaxNode parent,
    ChildRange range, str category)
    raises SyntaxValidationError, BoundsError, ArenaHandleError {
    if (range.start > file.storage.links.len()
        || range.length > file.storage.links.len() - range.start) { raise SyntaxValidationError { }; }
    usize index = usize(0);
    usize previous_end = parent.span.start_offset();
    while (index < range.len()) {
        validate_edge(file, parent, file.child(range, index), category);
        &in SyntaxNode child = file.node(file.child(range, index));
        if (child.span.start_offset() < previous_end) { raise SyntaxValidationError { }; }
        previous_end = child.span.end_offset();
        index = index + usize(1);
    }
}

void validate_text(&in SourceMap sources, &in SyntaxNode parent, SourceSpan text)
    raises SourceMapError, SyntaxValidationError {
    SourceId source = text.source_id();
    SourceId owner = parent.span.source_id();
    if (source.equals(owner) == false || text.start_offset() < parent.span.start_offset()
        || text.end_offset() > parent.span.end_offset()) { raise SyntaxValidationError { }; }
    sources.validate(text);
}

void validate_payload(&in SourceMap sources, &in ParsedFile file, &in SyntaxNode node)
    raises SyntaxValidationError, BoundsError, ArenaHandleError, SourceMapError {
    sources.validate(node.span);
    SourceId source = node.span.source_id();
    if (source.equals(file.source_id()) == false) { raise SyntaxValidationError { }; }
    match (&in node.data) {
        .invalid_declaration {
            if (file.has_errors() == false) { raise SyntaxValidationError { }; }
        }
        .invalid_statement {
            if (file.has_errors() == false) { raise SyntaxValidationError { }; }
        }
        .invalid_type {
            if (file.has_errors() == false) { raise SyntaxValidationError { }; }
        }
        .invalid_pattern {
            if (file.has_errors() == false) { raise SyntaxValidationError { }; }
        }
        .invalid_expression {
            if (file.has_errors() == false) { raise SyntaxValidationError { }; }
        }
        .module_declaration(path) {
            validate_text(sources, node, path);
        }
        .import_declaration(path, alias, symbols) {
            validate_text(sources, node, path);
            validate_text(sources, node, alias);
            validate_range(file, node, symbols, "import_symbol");
        }
        .import_path(name) {
            validate_text(sources, node, name);
        }
        .import_symbol(name) {
            validate_text(sources, node, name);
        }
        .struct_declaration(name, modifiers, parameters, body) {
            validate_text(sources, node, name);
            validate_range(file, node, parameters, "parameter");
            validate_link(file, node, body, "block", false);
        }
        .union_declaration(name, modifiers, parameters, body) {
            validate_text(sources, node, name);
            validate_range(file, node, parameters, "parameter");
            validate_link(file, node, body, "block", false);
        }
        .interface_declaration(name, modifiers, body) {
            validate_text(sources, node, name);
            validate_link(file, node, body, "block", false);
        }
        .implementation_declaration(target, interface_type, body) {
            validate_link(file, node, target, "type", false);
            validate_link(file, node, interface_type, "type", false);
            validate_link(file, node, body, "block", false);
        }
        .implementation_use(name) {
            validate_text(sources, node, name);
        }
        .view_declaration(name, modifiers, body) {
            validate_text(sources, node, name);
            validate_link(file, node, body, "block", false);
        }
        .view_field(name, mode, declared_type) {
            validate_text(sources, node, name);
            validate_text(sources, node, mode);
            validate_link(file, node, declared_type, "type", false);
        }
        .extern_type_declaration(name, modifiers) {
            validate_text(sources, node, name);
        }
        .function_declaration(name, modifiers, return_type, parameters, error_types, body) {
            validate_text(sources, node, name);
            validate_link(file, node, return_type, "type", true);
            validate_range(file, node, parameters, "parameter");
            validate_range(file, node, error_types, "type");
            validate_link(file, node, body, "block", true);
        }
        .parameter(name, modifiers, declared_type, constraints) {
            validate_text(sources, node, name);
            validate_link(file, node, declared_type, "type", true);
            validate_range(file, node, constraints, "type");
        }
        .field_declaration(name, modifiers, declared_type, initializer) {
            validate_text(sources, node, name);
            validate_link(file, node, declared_type, "type", false);
            validate_link(file, node, initializer, "expression", true);
        }
        .variable_declaration(name, modifiers, declared_type, initializer, arguments) {
            validate_text(sources, node, name);
            validate_link(file, node, declared_type, "type", false);
            validate_link(file, node, initializer, "expression", true);
            validate_range(file, node, arguments, "type_or_expression");
        }
        .constant_declaration(name, modifiers, declared_type, initializer) {
            validate_text(sources, node, name);
            validate_link(file, node, declared_type, "type", false);
            validate_link(file, node, initializer, "expression", false);
        }
        .comptime_type_declaration(name, modifiers, initializer) {
            validate_text(sources, node, name);
            validate_link(file, node, initializer, "expression", false);
        }
        .union_variant(name, parameters) {
            validate_text(sources, node, name);
            validate_range(file, node, parameters, "parameter");
        }
        .block_statement(statements) {
            validate_range(file, node, statements, "statement");
        }
        .unsafe_block(body) {
            validate_range(file, node, body, "statement");
        }
        .comptime_statement(statement) {
            validate_link(file, node, statement, "statement", false);
        }
        .expression_statement(expression) {
            validate_link(file, node, expression, "expression", false);
        }
        .assignment_statement(target, value) {
            validate_link(file, node, target, "expression", false);
            validate_link(file, node, value, "expression", false);
        }
        .if_statement(branches) {
            validate_range(file, node, branches, "branch");
        }
        .if_branch(condition, body) {
            validate_link(file, node, condition, "expression", false);
            validate_link(file, node, body, "block", false);
        }
        .else_branch(body) {
            validate_link(file, node, body, "block", false);
        }
        .while_statement(condition, body) {
            validate_link(file, node, condition, "expression", false);
            validate_link(file, node, body, "block", false);
        }
        .for_statement(initializer, condition, update, body) {
            validate_link(file, node, initializer, "statement", true);
            validate_link(file, node, condition, "expression", true);
            validate_link(file, node, update, "statement", true);
            validate_link(file, node, body, "block", false);
        }
        .try_statement(body, catches) {
            validate_link(file, node, body, "block", false);
            validate_range(file, node, catches, "catch");
        }
        .catch_clause(name, error_type, body) {
            validate_text(sources, node, name);
            validate_link(file, node, error_type, "type", false);
            validate_link(file, node, body, "block", false);
        }
        .return_statement(value) {
            validate_link(file, node, value, "expression", true);
        }
        .raise_statement(error) {
            validate_link(file, node, error, "expression", false);
        }
        .rethrow_statement {
        }
        .print_statement(value) {
            validate_link(file, node, value, "expression", false);
        }
        .match_statement(scrutinee, arms) {
            validate_link(file, node, scrutinee, "expression", false);
            validate_range(file, node, arms, "arm");
        }
        .match_expression(scrutinee, arms) {
            validate_link(file, node, scrutinee, "expression", false);
            validate_range(file, node, arms, "arm");
        }
        .match_arm(pattern, body) {
            validate_link(file, node, pattern, "pattern", false);
            validate_link(file, node, body, "arm_body", false);
        }
        .variant_pattern(name, bindings) {
            validate_text(sources, node, name);
            validate_range(file, node, bindings, "binding");
        }
        .wildcard_pattern {
        }
        .binding_pattern(name) {
            validate_text(sources, node, name);
        }
        .named_type(name) {
            validate_text(sources, node, name);
        }
        .generic_type(name, arguments) {
            validate_text(sources, node, name);
            validate_range(file, node, arguments, "type_or_expression");
        }
        .array_type(element, extent) {
            validate_link(file, node, element, "type", false);
            validate_link(file, node, extent, "expression", false);
        }
        .slice_type(element) {
            validate_link(file, node, element, "type", false);
        }
        .borrow_type(mode, target) {
            validate_text(sources, node, mode);
            validate_link(file, node, target, "type", true);
        }
        .raw_pointer_type(mode, target) {
            validate_text(sources, node, mode);
            validate_link(file, node, target, "type", false);
        }
        .nullable_pointer_type(mode, target) {
            validate_text(sources, node, mode);
            validate_link(file, node, target, "type", false);
        }
        .type_argument(value) {
            validate_link(file, node, value, "expression", false);
        }
        .name_expression(name) {
            validate_text(sources, node, name);
        }
        .integer_literal(spelling) {
            validate_text(sources, node, spelling);
        }
        .floating_literal(spelling) {
            validate_text(sources, node, spelling);
        }
        .string_literal(spelling) {
            validate_text(sources, node, spelling);
        }
        .formatted_string(parts) {
            validate_range(file, node, parts, "formatted_part");
        }
        .formatted_text(spelling) {
            validate_text(sources, node, spelling);
        }
        .boolean_literal(spelling) {
            validate_text(sources, node, spelling);
        }
        .null_literal {
        }
        .unary_expression(operator, operation, operand) {
            validate_text(sources, node, operator);
            if (operation == SyntaxOperator.invalid) { raise SyntaxValidationError { }; }
            validate_link(file, node, operand, "expression", false);
        }
        .binary_expression(operator, operation, left, right) {
            validate_text(sources, node, operator);
            validate_link(file, node, left, "expression", false);
            validate_link(file, node, right, "expression", false);
        }
        .borrow_expression(mode, operand) {
            validate_text(sources, node, mode);
            validate_link(file, node, operand, "expression", false);
        }
        .move_expression(operand) {
            validate_link(file, node, operand, "expression", false);
        }
        .dereference_expression(operand) {
            validate_link(file, node, operand, "expression", false);
        }
        .call_expression(callee, arguments) {
            validate_link(file, node, callee, "expression", false);
            validate_range(file, node, arguments, "type_or_expression");
        }
        .member_expression(name, receiver) {
            validate_text(sources, node, name);
            validate_link(file, node, receiver, "expression", false);
        }
        .index_expression(target, index) {
            validate_link(file, node, target, "expression", false);
            validate_link(file, node, index, "expression", false);
        }
        .slice_expression(target, start, end) {
            validate_link(file, node, target, "expression", false);
            validate_link(file, node, start, "expression", true);
            validate_link(file, node, end, "expression", true);
        }
        .struct_literal(declared_type, fields) {
            validate_link(file, node, declared_type, "type_or_expression", false);
            validate_range(file, node, fields, "field_value");
        }
        .struct_literal_field(name, value) {
            validate_text(sources, node, name);
            validate_link(file, node, value, "expression", false);
        }
        .union_variant_expression(name, arguments) {
            validate_text(sources, node, name);
            validate_range(file, node, arguments, "type_or_expression");
        }
        .parenthesized_expression(expression) {
            validate_link(file, node, expression, "expression", false);
        }
        .absent {
        }
    }
}

pub void validate_syntax(&in SourceMap sources, &in ParsedFile file)
    raises SyntaxValidationError, BoundsError, ArenaHandleError, SourceMapError,
        CapacityError, LayoutError, AllocationError {
    SystemAllocator pending_allocator;
    Vector(ArenaHandle(SyntaxNode), SystemAllocator) pending(pending_allocator, file.root_count());
    SystemAllocator seen_allocator;
    Vector(bool, SystemAllocator) seen(seen_allocator, file.node_count());
    usize index = usize(0);
    while (index < file.node_count()) { seen.push(false); index = index + usize(1); }
    index = usize(0);
    usize previous_end = usize(0);
    while (index < file.root_count()) {
        ArenaHandle(SyntaxNode) root = file.root(index);
        &in SyntaxNode node = file.node(root);
        if (node.span.start_offset() < previous_end
            || category_matches(node.kind(), "statement") == false) { raise SyntaxValidationError { }; }
        previous_end = node.span.end_offset();
        pending.push(root);
        index = index + usize(1);
    }
    while (pending.is_empty() == false) {
        ArenaHandle(SyntaxNode) handle = pending.pop();
        &in SyntaxNode node = file.node(handle);
        if (node.ordinal >= seen.len()) { raise SyntaxValidationError { }; }
        if (seen.get(node.ordinal)) { raise SyntaxValidationError { }; }
        &inout bool visited = seen.get_mut(node.ordinal);
        visited = true;
        validate_payload(sources, file, node);
        index = usize(0);
        while (index < child_count(node)) {
            pending.push(syntax_child(file, node, index));
            index = index + usize(1);
        }
    }
}
