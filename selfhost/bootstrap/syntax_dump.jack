module bootstrap.syntax_dump;

import bootstrap.source;
import bootstrap.syntax;
import std.collections.arena;
import std.collections.vector;
import std.memory;
import std.string;

void append_node_record(
    &inout StringBuilder(SystemAllocator) output,
    usize id,
    &in SyntaxNode node
) raises CapacityError, LayoutError, AllocationError {
    SourceSpan span = node.source_span();
    output.append("node\t");
    output.append_usize(id);
    output.append("\t");
    output.append(node.kind_name());
    output.append("\t");
    output.append_usize(span.start_offset());
    output.append("\t");
    output.append_usize(span.end_offset());
    output.append("\n");
    &in SyntaxData data = node.payload();
    match (data) {
        .invalid_declaration {
        }
        .invalid_statement {
        }
        .invalid_type {
        }
        .invalid_pattern {
        }
        .invalid_expression {
        }
        .module_declaration(path) {
            output.append("field\t"); output.append_usize(id);
            output.append("\tpath\t"); output.append_usize(path.start_offset());
            output.append("\t"); output.append_usize(path.end_offset()); output.append("\n");
        }
        .import_declaration(path, alias, symbols) {
            output.append("field\t"); output.append_usize(id);
            output.append("\tpath\t"); output.append_usize(path.start_offset());
            output.append("\t"); output.append_usize(path.end_offset()); output.append("\n");
            output.append("field\t"); output.append_usize(id);
            output.append("\talias\t"); output.append_usize(alias.start_offset());
            output.append("\t"); output.append_usize(alias.end_offset()); output.append("\n");
        }
        .import_path(name) {
            output.append("field\t"); output.append_usize(id);
            output.append("\tname\t"); output.append_usize(name.start_offset());
            output.append("\t"); output.append_usize(name.end_offset()); output.append("\n");
        }
        .import_symbol(name) {
            output.append("field\t"); output.append_usize(id);
            output.append("\tname\t"); output.append_usize(name.start_offset());
            output.append("\t"); output.append_usize(name.end_offset()); output.append("\n");
        }
        .struct_declaration(name, modifiers, parameters, body) {
            output.append("field\t"); output.append_usize(id);
            output.append("\tname\t"); output.append_usize(name.start_offset());
            output.append("\t"); output.append_usize(name.end_offset()); output.append("\n");
            SourceSpan abi = modifiers.abi_span();
            if (abi.end_offset() > abi.start_offset()) {
                output.append("field\t"); output.append_usize(id);
                output.append("\tabi\t"); output.append_usize(abi.start_offset());
                output.append("\t"); output.append_usize(abi.end_offset()); output.append("\n");
            }
            if (modifiers.public_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\tpublic\ttrue\n");
            }
            if (modifiers.comptime_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\tcomptime\ttrue\n");
            }
            if (modifiers.constant_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\tconstant\ttrue\n");
            }
            if (modifiers.unsafe_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\tunsafe\ttrue\n");
            }
            if (modifiers.extern_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\textern\ttrue\n");
            }
            if (modifiers.consuming_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\tconsuming\ttrue\n");
            }
            if (modifiers.constructor_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\tconstructor\ttrue\n");
            }
            if (modifiers.comptime_initializer_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\tcomptime_initializer\ttrue\n");
            }
            if (modifiers.raises_inferred_flag()) {
                output.append("value\t"); output.append_usize(id);
                output.append("\traises_inferred\ttrue\n");
            }
        }
        .union_declaration(name, modifiers, parameters, body) {
            output.append("field\t"); output.append_usize(id);
            output.append("\tname\t"); output.append_usize(name.start_offset());
            output.append("\t"); output.append_usize(name.end_offset()); output.append("\n");
            SourceSpan abi = modifiers.abi_span();
            if (abi.end_offset() > abi.start_offset()) {
