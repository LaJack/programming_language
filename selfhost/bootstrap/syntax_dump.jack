usize append_tree(
    &inout StringBuilder(SystemAllocator) output,
    &in ParsedFile file,
    ArenaHandle(SyntaxNode) handle,
    usize id,
    usize next
) raises CapacityError, LayoutError, AllocationError, BoundsError,
         ArenaHandleError {
    &in SyntaxNode node = file.node(handle);
    append_node_record(output, id, node);
    usize count = child_count(node);
    usize index = usize(0);
    usize role_index = usize(0);
    str previous_role = "";
    while (index < count) {
        ArenaHandle(SyntaxNode) child = syntax_child(file, node, index);
        usize child_id = next;
        next = next + usize(1);
        output.append("child\t");
        output.append_usize(id);
        output.append("\t");
        str role = child_role(node, index);
        if (role != previous_role) { role_index = usize(0); }
        output.append(role);
        output.append("\t");
        output.append_usize(role_index);
        role_index = role_index + usize(1);
        previous_role = role;
        output.append("\t");
        output.append_usize(child_id);
        output.append("\n");
        next = append_tree(output, file, child, child_id, next);
        index = index + usize(1);
    }
    return next;
}

pub String(SystemAllocator) dump_syntax(&in ParsedFile file)
    raises CapacityError, LayoutError, AllocationError, Utf8Error,
        BoundsError, ArenaHandleError
{
    SystemAllocator allocator;
    StringBuilder(SystemAllocator) output(allocator);
    usize next = usize(0);
    usize index = usize(0);
    while (index < file.root_count()) {
        usize id = next;
        next = next + usize(1);
        output.append("root\t");
        output.append_usize(index);
        output.append("\t");
        output.append_usize(id);
        output.append("\n");
        next = append_tree(output, file, file.root(index), id, next);
        index = index + usize(1);
    }
    return finish_string(SystemAllocator, output);
}
