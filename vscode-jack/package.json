{
  "name": "jack-lang",
  "displayName": "Jack Language",
  "description": "Syntax highlighting and editor basics for the experimental Jack language.",
  "version": "0.1.0",
  "publisher": "jack-lang",
  "license": "UNLICENSED",
  "private": true,
  "extensionDependencies": [
    "vadimcn.vscode-lldb"
  ],
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "jack",
    "comptime",
    "language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jack",
        "aliases": [
          "Jack",
          "jack"
        ],
        "extensions": [
          ".jack",
          ".jk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jack",
        "scopeName": "source.jack",
        "path": "./syntaxes/jack.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "jack",
        "scopes": {
          "namespace": ["entity.name.namespace"],
          "type": ["entity.name.type"],
          "struct": ["entity.name.type.struct"],
          "function": ["entity.name.function"],
          "method": ["entity.name.function.member"],
          "property": ["variable.other.property"],
          "parameter": ["variable.parameter"],
          "variable.readonly": ["variable.other.constant"]
        }
      }
    ],
    "breakpoints": [
      {
        "language": "jack"
      }
    ],
    "commands": [
      {
        "command": "jack.debugCurrentFile",
        "title": "Debug Current File",
        "category": "Jack"
      }
    ],
    "keybindings": [
      {
        "command": "jack.debugCurrentFile",
        "key": "f5",
        "when": "editorLangId == jack && !inDebugMode"
      }
    ],
    "taskDefinitions": [
      {
        "type": "jack",
        "required": [
          "entry",
          "output"
        ],
        "properties": {
          "entry": { "type": "string", "description": "Jack entry source file." },
          "output": { "type": "string", "description": "Debug executable path." },
          "backend": { "type": "string", "enum": ["llvm", "c"], "default": "llvm" },
          "optimization": { "type": "integer", "minimum": 0, "maximum": 3, "default": 0 },
          "moduleRoots": { "type": "array", "items": { "type": "string" }, "default": [] },
          "stubs": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
          "clang": { "type": "string", "default": "clang" }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "jack",
        "owner": "jack",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^jack: (.*):([0-9]+):([0-9]+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "configuration": {
      "title": "Jack",
      "properties": {
        "jack.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the experimental Jack language server."
        },
        "jack.lsp.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to launch the Jack language server."
        },
        "jack.lsp.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-m",
            "jack.lsp_server"
          ],
          "description": "Arguments passed to the Python executable when starting the Jack language server."
        },
        "jack.lsp.trace.server": {
          "type": "boolean",
          "default": false,
          "description": "Write raw language server messages to the Jack output channel."
        },
        "jack.lsp.analysisDelay": {
          "type": "integer",
          "minimum": 0,
          "default": 200,
          "description": "Delay in milliseconds before project semantic analysis starts after an edit."
        },
        "jack.compiler.path": {
          "type": "string",
          "default": "jack",
          "description": "Jack compiler executable used for builds and debugging."
        },
        "jack.compiler.moduleRoots": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional module search roots passed to the Jack compiler."
        },
        "jack.compiler.stubs": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "description": "Module-to-stub overrides used by debug builds."
        },
        "jack.compiler.clangPath": {
          "type": "string",
          "default": "clang",
          "description": "Clang executable used to link native debug builds."
        },
        "jack.debug.cwd": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Working directory of the debugged program."
        },
        "jack.debug.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments passed to the debugged program."
        },
        "jack.debug.env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "description": "Environment variables added to the debugged program."
        }
      }
    }
  },
  "scripts": {
    "package:vsix": "node ./scripts/package-vsix.cjs",
    "test": "node --test test/*.test.js"
  },
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:jack",
    "onCommand:jack.debugCurrentFile",
    "onTaskType:jack"
  ]
}
